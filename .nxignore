modules/
# Dot paths are runtime or tool state (daemon logs, sockets, job records, devenv and
# direnv caches, editor and Bun staging) unless tracked. Ignore all of them, then
# re-include each tracked dot input by its dot-named prefix. A directory must be
# re-included to reach its children, so `!/.github` covers `.github/**`.
# Nx's watcher reads only the root .gitignore and this file, never nested ignore files.
# `tooling:lint-dot-inputs` fails when a tracked dot path lacks its `!/` line below.
.*
!/.cowshed.toml
!/.editorconfig
!/.envrc
!/.git-format-staged.yml
!/.gitattributes
!/.gitignore
!/.npmrc
!/.nxignore
!/.prettierrc
!/.cargo
!/.config
!/.github
!/.verdaccio
!/.vscode
!/packages/.gitkeep
!/packages/columine/.cargo
!/packages/cowshed/.cargo
!/packages/bitmosaic/crates/bitmosaic/fuzz/.gitignore
!/packages/cowshed/.gitignore
!/packages/lmao-expo-benchmark/.gitignore
!/packages/lmao-ttsc/examples/.gitignore
!/packages/lmao-ttsc/plugin/.gitignore
!/packages/lmao/.cargo
!/packages/lmao/.planning
!/targets/lmao-docs/.gitignore
!/targets/lmao-docs/.vscode
!/tooling/direnv/.gitignore
