{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "sync": {
    "applyChanges": true
  },
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/package.json",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"],
    "lmaoGitRevision": [
      {
        "runtime": "sh -c 'if [ -n \"${LMAO_GIT_REVISION:-}\" ]; then printf \"%s\\n\" \"$LMAO_GIT_REVISION\"; elif revision=$(git rev-parse HEAD 2>/dev/null); then printf \"%s\\n\" \"$revision\"; else printf \"unknown\\n\"; fi'"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["typecheck-tests", "cargo-lint"],
      "inputs": [
        "default",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/patches/**/*",
        "{workspaceRoot}/biome.json",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tooling/checks/**/*"
      ],
      "options": {
        "commands": ["biome check --files-ignore-unknown=true {projectRoot}", "eslint {projectRoot}/src"],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "clean": {
      "executor": "@smoothbricks/nx-plugin:clean-outputs",
      "cache": false
    }
  },
  "plugins": ["@smoothbricks/nx-plugin"],
  "release": {
    "projects": ["tag:npm:public"],
    "projectsRelationship": "independent",
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "versionActions": "@smoothbricks/nx-plugin/version-actions"
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false,
        "file": false,
        "renderOptions": {
          "authors": true,
          "applyUsernameToAuthors": true
        }
      }
    }
  },
  "analytics": false
}
