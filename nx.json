{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "sync": {
    "applyChanges": true
  },
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/package.json",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"],
    "externalRustCrates": [
      {
        "runtime": "sh -c 'set -e; t=$(mktemp); trap \"rm -f \\\"$t\\\"\" EXIT; for d in \"/Users/danny/Dev/_fork/minigraf\"; do if [ ! -d \"$d\" ]; then echo \"externalRustCrates: missing $d\" >&2; exit 1; fi; files=$(cd \"$d\" && find . \\( -name target -o -name .git -o -name node_modules -o -name .fseventsd -o -name .cowshed -o -name .Trashes -o -name .TemporaryItems \\) -prune -o -type f \\( -name \"*.rs\" -o -name \"Cargo.toml\" \\) -print); if [ -z \"$files\" ]; then echo \"externalRustCrates: $d contributes no rust sources; a path dep that moved leaves this hashing nothing and every cached rust verdict unsound\" >&2; exit 1; fi; (cd \"$d\" && printf \"%s\\n\" \"$files\" | sort | xargs shasum -a 256) >> \"$t\"; done; shasum -a 256 < \"$t\" | cut -d\" \" -f1'"
      }
    ],
    "rustWorkspace": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/devenv.lock",
      "{workspaceRoot}/tooling/direnv/devenv.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/packages/columine/crates/**/*.rs",
      "{workspaceRoot}/packages/columine/crates/**/Cargo.toml",
      "{workspaceRoot}/packages/cowshed/crates/**/*.rs",
      "{workspaceRoot}/packages/cowshed/crates/**/Cargo.toml",
      "{workspaceRoot}/packages/cowshed/scripts/*.sh",
      "{workspaceRoot}/packages/lmao/crates/**/*.rs",
      "{workspaceRoot}/packages/lmao/crates/**/Cargo.toml",
      "{workspaceRoot}/packages/lmao/src/lib/schema/systemSchema.ts",
      "{workspaceRoot}/packages/lmao/src/lib/capacityTuning.ts"
    ],
    "lmaoGitRevision": [
      {
        "runtime": "sh -c 'if [ -n \"${LMAO_GIT_REVISION:-}\" ]; then printf \"%s\\n\" \"$LMAO_GIT_REVISION\"; elif revision=$(git rev-parse HEAD 2>/dev/null); then printf \"%s\\n\" \"$revision\"; else printf \"unknown\\n\"; fi'"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "executor": "@smoothbricks/nx-plugin:clean-outputs",
      "cache": false
    }
  },
  "plugins": ["@smoothbricks/nx-plugin"],
  "release": {
    "projects": ["tag:npm:public"],
    "projectsRelationship": "independent",
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "versionActions": "@smoothbricks/nx-plugin/version-actions"
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false,
        "file": false,
        "renderOptions": {
          "authors": true,
          "applyUsernameToAuthors": true
        }
      }
    }
  },
  "analytics": false
}
