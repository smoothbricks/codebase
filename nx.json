{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "sync": {
    "applyChanges": true,
    "globalGenerators": ["@smoothbricks/nx-plugin:managed-files"]
  },
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/**/*.md"],
    "dependencyDefault": [
      "default",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/test-timings.json"
    ],
    "production": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/package.json",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.md"
    ],
    "externalRustCrates": [
      {
        "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node node_modules/@smoothbricks/nx-plugin/dist/bin/smoo-nx-cargo-hash.js"
      }
    ],
    "rustWorkspace": [
      "cargoClosure",
      "cargoToolchain",
      "{workspaceRoot}/packages/cowshed/scripts/*.sh",
      "{workspaceRoot}/packages/lmao/src/lib/schema/systemSchema.ts",
      "{workspaceRoot}/packages/lmao/src/lib/capacityTuning.ts"
    ],
    "bunToolchain": [
      "{workspaceRoot}/tooling/direnv/nixpkgs-overlay/flake.nix",
      "{workspaceRoot}/tooling/direnv/nixpkgs-overlay/_sources/generated.nix",
      {
        "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun --revision"
      },
      { "externalDependencies": ["bun-lock:."] },
      "{workspaceRoot}/patches/**/*",
      "!{workspaceRoot}/patches/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default", "^dependencyDefault", { "externalDependencies": [] }]
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^dependencyDefault", "bunToolchain"]
    },
    "cargo-test": {
      "inputs": ["default", "^dependencyDefault", { "externalDependencies": [] }]
    },
    "cargo-lint": {
      "inputs": [{ "externalDependencies": [] }]
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "executor": "@smoothbricks/nx-plugin:clean-outputs",
      "cache": false
    },
    "cargo-test-cowshed-*": {
      "dependsOn": ["...", { "projects": ["cowshed"], "target": "apfs-test-root" }]
    },
    "cargo-test-group-real-apfs": {
      "dependsOn": [
        "...",
        { "projects": ["cowshed"], "target": "cli-native" },
        { "projects": ["cowshed"], "target": "apfs-test-root" }
      ],
      "options": { "env": { "COWSHED_EXECUTABLE": "{workspaceRoot}/packages/cowshed/bin/cowshed" } }
    },
    "cargo-test-group-real-apfs-host": {
      "dependsOn": [
        "...",
        { "projects": ["cowshed"], "target": "cli-native" },
        { "projects": ["cowshed"], "target": "apfs-test-root" },
        "cargo-test-group-real-apfs"
      ],
      "options": { "env": { "COWSHED_EXECUTABLE": "{workspaceRoot}/packages/cowshed/bin/cowshed" } }
    }
  },
  "plugins": [
    {
      "plugin": "@smoothbricks/nx-plugin",
      "options": {
        "producerReceipts": {
          "targets": [
            "lmao:rust-dist",
            "lmao:cargo-wasm:production",
            "lmao:cargo-thread-ffi",
            "cli:build",
            "nx-plugin:build"
          ]
        }
      }
    }
  ],
  "release": {
    "projects": ["tag:npm:public"],
    "projectsRelationship": "independent",
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "versionActions": "@smoothbricks/nx-plugin/version-actions"
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false,
        "file": false,
        "renderOptions": {
          "authors": true,
          "applyUsernameToAuthors": true
        }
      }
    }
  },
  "analytics": false,
  "cacheDirectory": ".nx/cache"
}
