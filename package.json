{
  "name": "@smoothbricks/codebase",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nx/eslint": "23.2.1",
    "@nx/expo": "23.2.1",
    "@nx/js": "23.2.1",
    "@smoothbricks/nx-plugin": "workspace:*",
    "@swc-node/register": "1.12.0",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@types/bun": "1.4.4",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-stdout": "workspace:*",
    "jiti": "^2.7.0",
    "mitata": "^1.0.34",
    "npm-packlist": "11.3.0",
    "nx": "23.2.1",
    "prettier": "^3.9.8",
    "tslib": "^2.8.1",
    "ttsc": "0.34.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typia": "15.2.1",
    "verdaccio": "6.8.0"
  },
  "scripts": {
    "build:all": "nx run-many -t build",
    "build:watch": "nx run-many -t build --watch",
    "check:linux": "tooling/devenv -P linux-cross shell -- nx run-many -t cargo-lint-cross",
    "clean:node_modules": "rm -rf node_modules && find e* t* p* -type d -name node_modules -print0 | xargs -0 rm -rvf",
    "clean:trace-db": "bun -e \"import { rmSync } from 'node:fs'; import { dirname, join } from 'node:path'; import { TRACE_DB_DIRECTORY } from './packages/lmao/src/lib/sqlite/trace-db-path.ts'; for (const manifest of new Bun.Glob('{package.json,tooling/package.json,{packages,targets}/*/package.json}').scanSync()) { rmSync(join(dirname(manifest), TRACE_DB_DIRECTORY), { recursive: true, force: true }); }\"",
    "format:changed": "git-format-staged --config .git-format-staged.yml --also-unstaged",
    "format:staged": "git-format-staged --config .git-format-staged.yml",
    "link:all": "bun run build:all && for pkg in packages/*; do (cd $pkg && bun link); done",
    "lint": "nx run-many -t lint",
    "lint:fix": "git-format-staged --config .git-format-staged.yml --unstaged",
    "list:nx-build-targets": "nx show projects | xargs -n1 nx show project --json | jq -r  '.name as $name | .targets | to_entries[] | \"\\($name):\\(.key)\"'",
    "postinstall": "bun tooling/direnv/developer-links.ts",
    "reload:direnv": "rm -rf tooling/direnv/.{direnv,devenv}; direnv reload",
    "reload:node_modules": "tooling/rm_node_modules; bun install",
    "show:tree": "tree --gitignore -d",
    "unlink:all": "for pkg in packages/*; do (cd $pkg && bun unlink); done",
    "update:cargo-lock": "cargo update",
    "update:devenv": "cd tooling/direnv; devenv update"
  },
  "sherif": {
    "ignoreDependency": [
      "typescript@^6.0.3"
    ]
  },
  "workspaces": [
    "packages/*",
    "targets/*",
    "tooling"
  ],
  "catalog": {
    "@types/node": "^26.6.6"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "host-e2e": {
        "executor": "nx:noop",
        "dependsOn": [
          "cargo-test-group-real-apfs",
          "cargo-test-group-real-apfs-host",
          {
            "target": "host-napi-test",
            "projects": [
              "cowshed"
            ]
          }
        ]
      },
      "gate": {
        "executor": "nx:noop",
        "dependsOn": [
          {
            "target": "lint",
            "projects": [
              "*"
            ]
          },
          {
            "target": "test",
            "projects": [
              "*"
            ]
          },
          {
            "target": "build",
            "projects": [
              "*"
            ]
          },
          "host-e2e"
        ]
      },
      "lint": {
        "dependsOn": [
          "...",
          "spec-links",
          "no-unbounded-wait",
          "forbidden-spellings",
          "wiring-lint",
          "monorepo-check"
        ],
        "inputs": [
          "...",
          "{workspaceRoot}/**/*.rs",
          "{workspaceRoot}/**/*.test.*",
          "{workspaceRoot}/**/*.spec.*",
          "{workspaceRoot}/**/*-test.*",
          "{workspaceRoot}/**/*_test.*",
          "{workspaceRoot}/**/test-*",
          "{workspaceRoot}/**/test_*",
          "{workspaceRoot}/**/test-*/**/*",
          "{workspaceRoot}/**/test_*/**/*",
          "{workspaceRoot}/**/__tests__/**/*",
          "{workspaceRoot}/**/tests/**/*",
          "{workspaceRoot}/**/test/**/*",
          "{workspaceRoot}/**/nx-it/**/*",
          "{workspaceRoot}/packages/nx-plugin/src/test-walk-policy.ts",
          "{workspaceRoot}/packages/nx-plugin/src/bin/smoo-nx-test-walks.ts",
          "{workspaceRoot}/packages/nx-plugin/src/test-clock-policy.ts",
          "{workspaceRoot}/packages/nx-plugin/src/bounded-test-policy.ts",
          "{workspaceRoot}/packages/nx-plugin/src/bin/smoo-nx-test-clocks.ts",
          "{workspaceRoot}/packages/validation/src/bun/preload.ts"
        ],
        "options": {
          "commands": [
            "biome check --files-ignore-unknown=true {projectRoot}",
            "bun packages/nx-plugin/src/bin/smoo-nx-test-walks.ts",
            "bun --preload ./packages/validation/src/bun/preload.ts packages/nx-plugin/src/bin/smoo-nx-test-clocks.ts"
          ]
        }
      },
      "spec-links": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*"
        ],
        "options": {
          "command": "bun tooling/checks/spec-links.fixtures.ts && bun tooling/checks/compiled-in-docs.fixtures.ts && bun tooling/checks/spec-links.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "no-unbounded-wait": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tooling/checks/no-unbounded-wait.ts",
          "{workspaceRoot}/tooling/checks/no-unbounded-wait.fixtures.ts",
          "{workspaceRoot}/packages/lmao/src/lib/errors/Deadline.ts",
          "{workspaceRoot}/packages/lmao/src/lib/result.ts",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "options": {
          "command": "bun tooling/checks/no-unbounded-wait.fixtures.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "forbidden-spellings": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*"
        ],
        "options": {
          "command": "bun packages/nx-plugin/src/bin/smoo-nx-forbidden-spellings.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "wiring": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun tooling/wiring.fixtures.ts && bun tooling/wiring.ts",
          "cwd": "{workspaceRoot}"
        },
        "//": "WIRING (AGENTS.md rule 7: done means the production path calls it): refuses each item the change adds since --base <commit oid> (an exported value, a Rust pub item, a wire op, a CLI verb, a script or an Nx target) that no production code in the tree reaches, naming it and its file:line. A published package's manifest entries (exports, main, module, bin, also under publishConfig) are callers of the modules and scripts they expose. tooling/land-host.sh runs it on the rebased tree against the main head it rebased onto, before the gate; by hand, --args='--base <oid>'. Cached: the inputs are the whole tree and the argument names an immutable commit, so a cached verdict cannot outlive what it judged. The planted fixtures run first, so a judge that stopped resolving cannot pass as a wired change."
      },
      "wiring-lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun tooling/wiring.fixtures.ts && bun tooling/wiring.ts --tree",
          "cwd": "{workspaceRoot}"
        },
        "//": "The root lint's WIRING: every item of every Nx project tagged wiring:enforced is reached by production code. A project carries the tag once it is clean; agent-todo/wiring-sweep.md lists the rest until each is wired or deleted and tagged, so the enforced scope only grows and nothing is exempt. The inputs are the whole tree because removing a caller anywhere changes an enforced verdict."
      },
      "monorepo-check": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*",
          "{workspaceRoot}/packages/nx-plugin/runtime-input.sh",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh sh -c 'for directory in packages/*/dist-test targets/*/dist-test tooling/dist-test; do if [ -d \"$directory\" ]; then echo \"$directory\"; fi; done'"
          }
        ],
        "outputs": [],
        "options": {
          "command": "smoo monorepo check --warn",
          "cwd": "{workspaceRoot}"
        },
        "//": "MONOREPO: the package conventions and managed-file drift that publish's 'Check managed monorepo files' step refuses on, run in the root lint where lands are judged instead of first at publish. Cached on the whole tree, which holds every manifest, lock and managed file it reads, and on the gitignored dist-test directories it refuses, which no file input sees. The devenv release check asks the remote on every run, but a pushed release tag is permanent and Nx caches no failure, so a cached pass cannot outlive what it judged; it needs the remote reachable and fails rather than passes offline."
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "cargo-lint": {
        "inputs": [
          "rustWorkspace",
          {
            "env": "LMAO_GIT_REVISION"
          },
          {
            "externalDependencies": []
          }
        ]
      },
      "cargo-lint-cross": {
        "inputs": [
          "rustWorkspace",
          {
            "env": "LMAO_GIT_REVISION"
          },
          {
            "externalDependencies": []
          }
        ]
      },
      "cargo-test-build": {
        "dependsOn": [
          "...",
          {
            "target": "wire-fixtures",
            "projects": [
              "cowshed"
            ]
          }
        ],
        "inputs": [
          "...",
          "{workspaceRoot}/packages/cowshed/src/wire-fixtures.json",
          {
            "env": "LMAO_GIT_REVISION"
          }
        ]
      },
      "cargo-test-group-real-apfs": {
        "dependsOn": [
          "...",
          {
            "projects": [
              "@smoothbricks/codebase"
            ],
            "target": "cargo-test-build"
          }
        ]
      },
      "cargo-test-group-real-apfs-host": {
        "dependsOn": [
          "...",
          {
            "projects": [
              "@smoothbricks/codebase"
            ],
            "target": "cargo-test-build"
          }
        ]
      }
    },
    "name": "@smoothbricks/codebase"
  },
  "patchedDependencies": {
    "@uwdata/flechette@2.7.0": "patches/@uwdata%2Fflechette@2.7.0.patch",
    "@conloca/content-api@0.1.16": "patches/@conloca%2Fcontent-api@0.1.16.patch",
    "@conloca/astro-cms@0.1.16": "patches/@conloca%2Fastro-cms@0.1.16.patch",
    "nx@23.2.1": "patches/nx@23.2.1.patch",
    "@nx/js@23.2.1": "patches/@nx%2Fjs@23.2.1.patch",
    "ttsc@0.34.1": "patches/ttsc@0.34.1.patch",
    "typia@15.2.1": "patches/typia@15.2.1.patch",
    "@typia/interface@15.2.1": "patches/@typia%2Finterface@15.2.1.patch",
    "scriptc@0.4.4": "patches/scriptc@0.4.4.patch"
  },
  "overrides": {
    "typia": "15.2.1",
    "@nx/js": "23.2.1",
    "nx": "23.2.1"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "nx",
    "scriptc",
    "sharp"
  ],
  "smoo": {
    "github": {
      "runsOn": [
        "nixos-latest-x64",
        "self-hosted"
      ]
    }
  }
}
