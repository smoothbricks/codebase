{
  "name": "@smoothbricks/arrow-builder",
  "version": "0.1.11-next.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./arrow": {
      "types": "./dist/lib/arrow/index.d.ts",
      "import": "./dist/lib/arrow/index.js",
      "default": "./dist/lib/arrow/index.js"
    },
    "./schema": {
      "types": "./dist/lib/schema/index.d.ts",
      "import": "./dist/lib/schema/index.js",
      "default": "./dist/lib/schema/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@uwdata/flechette": "^2.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@smoothbricks/validation": "workspace:*"
  },
  "nx": {
    "sourceRoot": "packages/arrow-builder/src",
    "projectType": "library",
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "arrow-builder"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/arrow-builder"
  },
  "scripts": {
    "test": "nx run arrow-builder:test --outputStyle=stream"
  }
}
