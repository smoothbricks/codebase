{
  "name": "@smoothbricks/build-inputs",
  "version": "0.0.1-next.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts/build-inputs.js",
  "module": "./dist/ts/build-inputs.js",
  "types": "./dist/ts/build-inputs.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/build-inputs.d.ts",
      "import": "./dist/ts/build-inputs.js",
      "default": "./dist/ts/build-inputs.js"
    }
  },
  "bin": {
    "smoo-nx-build-inputs": "./dist/ts/bin/smoo-nx-build-inputs.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run build-inputs:test --outputStyle=stream"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@scriptc/runtime-darwin-arm64": "0.4.4",
    "@scriptc/runtime-darwin-x64": "0.4.4",
    "@scriptc/runtime-linux-arm64-musl": "0.4.4",
    "@scriptc/runtime-linux-x64-musl": "0.4.4",
    "@smoothbricks/cargo-retain": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "scriptc": "0.4.4"
  },
  "nx": {
    "name": "build-inputs",
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/build-inputs"
  }
}
