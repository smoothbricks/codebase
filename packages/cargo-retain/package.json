{
  "name": "@smoothbricks/cargo-retain",
  "version": "0.0.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts/cargo-retention.js",
  "module": "./dist/ts/cargo-retention.js",
  "types": "./dist/ts/cargo-retention.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/cargo-retention.d.ts",
      "import": "./dist/ts/cargo-retention.js",
      "default": "./dist/ts/cargo-retention.js"
    },
    "./cargo-ancestor-inputs": {
      "types": "./dist/ts/cargo-ancestor-inputs.d.ts",
      "import": "./dist/ts/cargo-ancestor-inputs.js",
      "default": "./dist/ts/cargo-ancestor-inputs.js"
    },
    "./launch-node": {
      "types": "./dist/ts/launch-node.d.ts",
      "import": "./dist/ts/launch-node.js",
      "default": "./dist/ts/launch-node.js"
    },
    "./locks-node": {
      "types": "./dist/ts/locks-node.d.ts",
      "import": "./dist/ts/locks-node.js",
      "default": "./dist/ts/locks-node.js"
    },
    "./open-flags": {
      "types": "./dist/ts/open-flags.d.ts",
      "import": "./dist/ts/open-flags.js",
      "default": "./dist/ts/open-flags.js"
    },
    "./testing/cargo-fixture": {
      "types": "./dist/ts/testing/cargo-fixture.d.ts",
      "development": "./src/testing/cargo-fixture.ts",
      "import": "./dist/ts/testing/cargo-fixture.js",
      "default": "./dist/ts/testing/cargo-fixture.js"
    },
    "./testing/fixture-cargo-home": {
      "types": "./dist/ts/testing/fixture-cargo-home.d.ts",
      "development": "./src/testing/fixture-cargo-home.ts",
      "import": "./dist/ts/testing/fixture-cargo-home.js",
      "default": "./dist/ts/testing/fixture-cargo-home.js"
    },
    "./testing/outside-trees": {
      "types": "./dist/ts/testing/outside-trees.d.ts",
      "development": "./src/testing/outside-trees.ts",
      "import": "./dist/ts/testing/outside-trees.js",
      "default": "./dist/ts/testing/outside-trees.js"
    }
  },
  "bin": {
    "smoo-nx-cargo-retain": "./dist/ts/node-cli.js"
  },
  "files": [
    "dist",
    "src",
    "ffi.json",
    "native",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run cargo-retain:test --outputStyle=stream"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "typia": "15.2.1"
  },
  "devDependencies": {
    "@scriptc/runtime-darwin-arm64": "0.4.4",
    "@scriptc/runtime-darwin-x64": "0.4.4",
    "@scriptc/runtime-linux-arm64-musl": "0.4.4",
    "@scriptc/runtime-linux-x64-musl": "0.4.4",
    "@smoothbricks/validation": "workspace:*",
    "scriptc": "0.4.4"
  },
  "scriptc": {
    "entries": {
      "smoo-nx-cargo-retain": "./dist/ts/bin/smoo-nx-cargo-retain.js"
    },
    "ffi": {
      "manifest": "ffi.json",
      "declarations": {
        "src/ffi.d.ts": "ffi.d.ts"
      },
      "sources": [
        "native/flock.c"
      ]
    }
  },
  "nx": {
    "name": "cargo-retain",
    "targets": {
      "lint": {},
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "test-node",
          "test-native"
        ]
      },
      "test-node": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-native": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          }
        ],
        "dependsOn": [
          "...",
          "build"
        ],
        "options": {
          "command": "bun test --timeout=0 ./src/__tests__/native-cli.differential.ts",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/cargo-retain"
  }
}
