{
  "name": "@smoothbricks/cargo-retain",
  "version": "0.0.1-next.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cargo-retention.js",
  "module": "./dist/cargo-retention.js",
  "types": "./dist/cargo-retention.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/cargo-retention.d.ts",
      "import": "./dist/cargo-retention.js",
      "default": "./dist/cargo-retention.js"
    },
    "./cargo-ancestor-inputs": {
      "types": "./dist/cargo-ancestor-inputs.d.ts",
      "import": "./dist/cargo-ancestor-inputs.js",
      "default": "./dist/cargo-ancestor-inputs.js"
    },
    "./open-flags": {
      "types": "./dist/open-flags.d.ts",
      "import": "./dist/open-flags.js",
      "default": "./dist/open-flags.js"
    },
    "./testing/cargo-fixture": {
      "types": "./dist/testing/cargo-fixture.d.ts",
      "development": "./src/testing/cargo-fixture.ts",
      "import": "./dist/testing/cargo-fixture.js",
      "default": "./dist/testing/cargo-fixture.js"
    },
    "./testing/fixture-cargo-home": {
      "types": "./dist/testing/fixture-cargo-home.d.ts",
      "development": "./src/testing/fixture-cargo-home.ts",
      "import": "./dist/testing/fixture-cargo-home.js",
      "default": "./dist/testing/fixture-cargo-home.js"
    },
    "./testing/outside-trees": {
      "types": "./dist/testing/outside-trees.d.ts",
      "development": "./src/testing/outside-trees.ts",
      "import": "./dist/testing/outside-trees.js",
      "default": "./dist/testing/outside-trees.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run cargo-retain:test --outputStyle=stream"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "typia": "14.0.6"
  },
  "devDependencies": {
    "@smoothbricks/validation": "workspace:*"
  },
  "nx": {
    "name": "cargo-retain",
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/cargo-retain"
  }
}
