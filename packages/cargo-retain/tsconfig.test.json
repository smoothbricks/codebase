{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "node"],
    "lib": ["es2022", "es2024.sharedmemory"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/test-suite-tracer.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    { "path": "../validation/tsconfig.lib.json" }
  ]
}
