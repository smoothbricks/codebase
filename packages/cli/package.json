{
  "name": "@smoothbricks/cli",
  "version": "0.12.25-next.0",
  "type": "module",
  "description": "SmoothBricks monorepo automation CLI",
  "bin": {
    "smoo": "./bin/smoo"
  },
  "scripts": {
    "test": "nx run cli:test --outputStyle=stream"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun/preload": {
      "types": "./dist/bun/preload.d.ts",
      "bun": "./src/bun/preload.ts",
      "development": "./src/bun/preload.ts",
      "import": "./dist/bun/preload.js",
      "default": "./dist/bun/preload.js"
    },
    "./monorepo/runtime": {
      "types": "./dist/monorepo/runtime.d.ts",
      "bun": "./src/monorepo/runtime.ts",
      "development": "./src/monorepo/runtime.ts",
      "import": "./dist/monorepo/runtime.js",
      "default": "./dist/monorepo/runtime.js"
    },
    "./monorepo/git-config": {
      "types": "./dist/monorepo/git-config.d.ts",
      "bun": "./src/monorepo/git-config.ts",
      "development": "./src/monorepo/git-config.ts",
      "import": "./dist/monorepo/git-config.js",
      "default": "./dist/monorepo/git-config.js"
    },
    "./release/pack": {
      "types": "./dist/release/pack.d.ts",
      "development": "./src/release/pack.ts",
      "import": "./dist/release/pack.js",
      "default": "./dist/release/pack.js"
    },
    "./secrets": {
      "types": "./dist/secrets/status.d.ts",
      "development": "./src/secrets/status.ts",
      "import": "./dist/secrets/status.js",
      "default": "./dist/secrets/status.js"
    },
    "./wrangler/prepare-env": {
      "types": "./dist/wrangler/prepare-env.d.ts",
      "bun": "./src/wrangler/prepare-env.ts",
      "development": "./src/wrangler/prepare-env.ts",
      "import": "./dist/wrangler/prepare-env.js",
      "default": "./dist/wrangler/prepare-env.js"
    },
    "./wrangler/stage": {
      "types": "./dist/wrangler/stage.d.ts",
      "bun": "./src/wrangler/stage.ts",
      "development": "./src/wrangler/stage.ts",
      "import": "./dist/wrangler/stage.js",
      "default": "./dist/wrangler/stage.js"
    }
  },
  "sideEffects": [
    "./dist/bun/preload.js",
    "./src/bun/preload.ts"
  ],
  "files": [
    "README.md",
    "bin",
    "dist",
    "src",
    "test-timings.json",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@smoothbricks/build-inputs": "workspace:*",
    "@smoothbricks/failure-summary": "workspace:*",
    "@smoothbricks/nextest-extract": "workspace:*",
    "@smoothbricks/nx-plugin": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "commander": "^14.0.3",
    "nx": "latest",
    "prettier": "^3.9.8",
    "publint": "^0.3.18",
    "semver": "^7.7.4",
    "sherif": "^1.11.1",
    "toml-eslint-parser": "^1.0.3",
    "tslib": "^2.8.1",
    "typia": "15.2.1"
  },
  "devDependencies": {
    "fast-check": "^4.4.0"
  },
  "nx": {
    "targets": {
      "lint": {},
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "test-shard-1",
          "test-shard-2",
          "test-shard-3",
          "test-shard-4",
          "test-shard-5"
        ]
      },
      "test-shard-1": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=1/5",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard-2": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=2/5",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard-3": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=3/5",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard-4": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=4/5",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard-5": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=5/5",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/cli"
  }
}
