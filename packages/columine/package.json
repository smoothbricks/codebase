{
  "name": "@smoothbricks/columine",
  "version": "0.3.2",
  "description": "Columine - Generic columnar processing pipeline (Parse, Reduce, Compact, Undo) for Arrow column data",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    },
    "./wasm": "./dist/columine.wasm"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.map",
    "dist/**/*.wasm"
  ],
  "scripts": {
    "test": "nx run columine:test --outputStyle=stream",
    "build:wasm": "nx run columine:cargo-wasm"
  },
  "nx": {
    "targets": {
      "lint": {},
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "...",
          "cargo-wasm",
          "cargo-test"
        ],
        "options": {
          "command": "bun test --timeout=0 src/__tests__",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "cargo-test": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-test-columine-ep-wasm": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-test-columine-wasm": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-wasm": {
        "//": "Every workspace member's Cargo.toml is an input, not only columine's and bitmosaic's: .cargo/config.toml resolves features workspace-wide, so a host-only crate's manifest decides which features the wasm32 build compiles. Moving cowshed-shell's brush edge out of wasm32 changed event_processor.wasm's imports without touching any path this target used to hash. outputDir is the directory each configuration's recipes copy into and its declared outputs name, one option for both so the copy cannot differ from what Nx restores: .cache/wasm-dev by default, dist in production, the tree the package publishes (packages/nx-plugin/README.md, Cargo profiles). src/wasm-memory-contract.ts loads the build its package's source authority names.",
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/crates/**/*.rs",
          "{workspaceRoot}/packages/bitmosaic/crates/**/*.rs",
          "{workspaceRoot}/packages/*/crates/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          {
            "externalDependencies": [
              "cargo-lock:packages/columine",
              "bun-lock:packages/columine"
            ]
          },
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/justfile"
        ],
        "outputs": [
          "{projectRoot}/{options.outputDir}/columine.wasm",
          "{projectRoot}/{options.outputDir}/event_processor.wasm"
        ],
        "options": {
          "command": "just wasm dev {args.outputDir} && just wasm-ep dev {args.outputDir}",
          "cwd": "{projectRoot}",
          "outputDir": ".cache/wasm-dev"
        },
        "configurations": {
          "production": {
            "command": "just wasm wasm-release {args.outputDir} && just wasm-ep wasm-release {args.outputDir}",
            "outputDir": "dist"
          }
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "columine"
  },
  "devDependencies": {
    "@smoothbricks/validation": "workspace:*",
    "@uwdata/flechette": "^2.7.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/columine"
  }
}
