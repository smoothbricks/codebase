{
  "name": "@smoothbricks/columine",
  "version": "0.2.1-next.0",
  "description": "Columine - Generic columnar processing pipeline (Parse, Reduce, Compact, Undo) for Arrow column data",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    },
    "./wasm": "./dist/columine.wasm"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.map",
    "dist/**/*.wasm"
  ],
  "scripts": {
    "test": "nx run columine:test --outputStyle=stream",
    "build:wasm": "nx run columine:cargo-wasm"
  },
  "nx": {
    "targets": {
      "lint": {},
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "cargo-wasm",
          "cargo-test"
        ],
        "options": {
          "command": "bun test --timeout=30000 src/__tests__",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "cargo-test": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-test-columine-ep-wasm": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-test-columine-wasm": {
        "dependsOn": [
          "...",
          "cargo-wasm"
        ]
      },
      "cargo-wasm": {
        "//": "Every workspace member's Cargo.toml is an input, not only columine's and bitmosaic's: .cargo/config.toml resolves features workspace-wide, so a host-only crate's manifest decides which features the wasm32 build compiles. Moving cowshed-shell's brush edge out of wasm32 changed event_processor.wasm's imports without touching any path this target used to hash.",
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/crates/**/*.rs",
          "{workspaceRoot}/packages/bitmosaic/crates/**/*.rs",
          "{workspaceRoot}/packages/*/crates/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/justfile"
        ],
        "outputs": [
          "{projectRoot}/dist/columine.wasm",
          "{projectRoot}/dist/event_processor.wasm"
        ],
        "options": {
          "command": "just wasm && just wasm-ep",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "production": {
            "command": "just wasm wasm-release && just wasm-ep wasm-release"
          }
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "columine"
  },
  "devDependencies": {
    "@smoothbricks/validation": "workspace:*",
    "@uwdata/flechette": "^2.3.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/columine"
  }
}
