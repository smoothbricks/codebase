#!/bin/sh
# Run the native cowshed CLI built for this host (06_cli.md "Launcher").
#
# The package's `bin`, and the one place that decides which binary answers. A POSIX shell script
# rather than Node: it runs before every command, and Node's own start costs more than a resident
# `cowshed path` takes in total. It execs the binary, so the command's signals, exit status and
# standard streams are the binary's own.
#
# Which binary:
# - `setup` and `gateway` deliberately run the invoking binary, because `setup` writes the stable
#   install and `gateway start`/`status` compare the daemon's executable with the one asking.
# - a published package, or a checkout's launcher linked from outside that checkout, is a consumer:
#   every other verb runs the host-stable install when it exists. Another build cannot read the
#   install's daemon and records.
# - otherwise source authority picks the build. A checkout holds the tracked
#   crates/cowshed-cli/src/main.rs no published package ships and runs .cache/bin/<platform>/;
#   a published package runs dist/bin/<platform>/, restoring an execute bit a publish lost.
#   Neither substitutes the other build or a cargo target/release. Only presence is judged;
#   development-build currentness is the shell-entry guard's question, never each exec's.
set -eu

# Package managers link `bin` entries, sometimes through a chain of links.
invoked=$0
launcher=$0
while [ -h "$launcher" ]; do
  target=$(readlink "$launcher")
  case $target in
  /*) launcher=$target ;;
  *) launcher=${launcher%/*}/$target ;;
  esac
done
package=${launcher%/*}/..

# Kept in step with the `cli` directories of NATIVE_TARGETS in src/platform.ts; launcher.test.ts checks this table.
case $(uname -sm) in
"Darwin arm64") platform=darwin-arm64 ;;
"Darwin x86_64") platform=darwin-x64 ;;
"Linux aarch64" | "Linux arm64") platform=linux-arm64 ;;
"Linux x86_64") platform=linux-x64 ;;
*) platform= ;;
esac

searched=
consider() {
  searched=${searched:+$searched, }$1
  [ -f "$1" ]
}

# Find the verb without consuming argv; --project takes one value, even one named setup or gateway.
stable=${HOME:-}/Library/Application\ Support/dev.cowshed/bin/cowshed
verb=
project_value=false
for argument in "$@"; do
  if [ "$project_value" = true ]; then
    project_value=false
    continue
  fi
  case $argument in
  --project) project_value=true; continue ;;
  -*) continue ;;
  esac
  verb=$argument
  break
done

if [ -z "$platform" ]; then
  echo "cowshed: cowshed ships no CLI binary for $(uname -sm)" >&2
  exit 5
fi

development=
if [ -f "$package/crates/cowshed-cli/src/main.rs" ]; then
  development=$package/.cache/bin/$platform/cowshed
fi
case $verb in
setup | gateway) ;;
*)
  if [ -n "$development" ]; then
    # Where the link chain started: a directory outside this checkout is another repository's.
    checkout=$(cd "$package/../.." && pwd -P)
    case $invoked in
    */*) from=$(cd "${invoked%/*}" 2>/dev/null && pwd -P) || from=$checkout ;;
    *) from=$checkout ;;
    esac
    case $from/ in
    "$checkout"/*) stable= ;;
    esac
  fi
  if [ -n "$stable" ] && consider "$stable"; then
    exec "$stable" "$@"
  fi
  ;;
esac

if [ -n "$development" ]; then
  # Written by this checkout's own build, so unlike a published binary it keeps its execute bit.
  if consider "$development"; then
    exec "$development" "$@"
  fi
  echo "cowshed: no development CLI build found; looked in $searched" >&2
  echo "next: build it with \`nx run cowshed:cli-native\`" >&2
  exit 5
fi

packaged=$package/dist/bin/$platform/cowshed
if consider "$packaged"; then
  # A publish can apply the binaries without their execute bit; restore it once. An
  # unwritable copy stays as it is, and exec reports the permission it lacks.
  [ -x "$packaged" ] || chmod +x "$packaged" 2>/dev/null || :
  exec "$packaged" "$@"
fi
echo "cowshed: no cowshed CLI binary found; looked in $searched" >&2
echo "next: install a published @smoothbricks/cowshed" >&2
exit 5
