+    // Before the caller's own mappings, as on the cached path: a caller's
+    // --remap-path-prefix for a path inside the checkout still wins.
+    let (before, after) = arguments.split_at(compile.first_remap.unwrap_or(arguments.len()));
+    Ok(Some(
+        before
+            .iter()
+            .cloned()
+            .chain(added)
+            .chain(after.iter().cloned())
+            .collect(),
+    ))
+}
+
+/// The rustc flags `ProcMacroCompile::scan` reads, each of which takes a value.
+#[derive(Clone, Copy)]
+enum ScannedFlag {
+    CrateType,
+    CrateName,
+    Codegen,
+    Output,
+    Remap,
+}
+
+const SCANNED_FLAGS: [(&str, ScannedFlag); 6] = [
+    ("--crate-type", ScannedFlag::CrateType),
+    ("--crate-name", ScannedFlag::CrateName),
+    ("-C", ScannedFlag::Codegen),
+    ("--codegen", ScannedFlag::Codegen),
+    ("-o", ScannedFlag::Output),
+    ("--remap-path-prefix", ScannedFlag::Remap),
+];
+
+/// What `local_compile_arguments` reads from a proc-macro command line.
+struct ProcMacroCompile<'a> {
+    crate_name: Option<&'a str>,
+    extra_filename: &'a str,
+    output: Option<&'a Path>,
+    /// The index of the caller's first `--remap-path-prefix`.
+    first_remap: Option<usize>,
+}
+
+impl<'a> ProcMacroCompile<'a> {
+    /// `Some` iff `arguments` compile a proc-macro crate. A flag's value is the next argument,
+    /// or joined to it (`--flag=value`, `-Cvalue`, `-ovalue`).
+    fn scan(arguments: &'a [OsString]) -> Option<Self> {
+        let mut proc_macro = false;
+        let mut compile = Self {
+            crate_name: None,
+            extra_filename: "",
+            output: None,
+            first_remap: None,
+        };
+        let named = |text: &str| {
+            SCANNED_FLAGS
+                .iter()
+                .find(|(name, _)| *name == text)
+                .map(|&(_, flag)| flag)
+        };
+        let mut i = 0;
+        while i < arguments.len() {
+            let index = i;
+            i += 1;
+            let Some(text) = arguments[index].to_str() else {
+                continue;
+            };
+            let (flag, value): (ScannedFlag, &OsStr) = if let Some(flag) = named(text) {
+                let Some(value) = arguments.get(i) else {
+                    break;
+                };
+                i += 1;
+                (flag, value)
+            } else if let Some((flag, value)) = text
+                .split_once('=')
+                .filter(|(name, _)| name.starts_with("--"))
+                .and_then(|(name, value)| Some((named(name)?, value)))
+            {
+                (flag, OsStr::new(value))
+            } else if let Some(value) = text.strip_prefix("-C").filter(|v| !v.is_empty()) {
+                (ScannedFlag::Codegen, OsStr::new(value))
+            } else if let Some(value) = text.strip_prefix("-o").filter(|v| !v.is_empty()) {
+                (ScannedFlag::Output, OsStr::new(value))
+            } else {
+                continue;
+            };
+            match flag {
+                ScannedFlag::CrateType => {
+                    proc_macro |= value
+                        .to_str()
+                        .is_some_and(|types| types.split(',').any(|t| t == "proc-macro"))
+                }
+                ScannedFlag::CrateName => compile.crate_name = value.to_str(),
+                ScannedFlag::Codegen => {
+                    if let Some(extra) = value
+                        .to_str()
+                        .and_then(|option| option.strip_prefix("extra-filename="))
+                    {
+                        compile.extra_filename = extra;
+                    }
+                }
+                ScannedFlag::Output => compile.output = Some(Path::new(value)),
+                ScannedFlag::Remap => {
+                    compile.first_remap.get_or_insert(index);
+                }
+            }
+        }
+        proc_macro.then_some(compile)
+    }
+
+    /// The file name rustc links the macro to: `-o`'s, else cargo's `lib<name><extra>.dylib`.
+    fn output_file_name(&self) -> Option<OsString> {
+        match self.output {
+            Some(output) => output.file_name().map(OsStr::to_owned),
+            None => self
+                .crate_name
+                .map(|name| format!("lib{name}{}.dylib", self.extra_filename).into()),
+        }
+    }
+}
