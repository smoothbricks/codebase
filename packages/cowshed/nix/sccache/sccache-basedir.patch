+/// The client's per-request base directory, `SCCACHE_BASEDIR`: a path prefix this request's
+/// key omits, as every request's key omits the server's `SCCACHE_BASEDIRS`. A build names it
+/// where its checkout root is not the compiler's working directory (cmake and ninja compile
+/// from a build directory below it). Unset or empty means none. Returned absolute, without a
+/// trailing separator, `.` components or doubled separators.
+pub fn request_basedir(env_vars: &[(OsString, OsString)]) -> Result<Option<PathBuf>> {
+    let Some((_, value)) = env_vars
+        .iter()
+        .find(|(k, v)| k == "SCCACHE_BASEDIR" && !v.is_empty())
+    else {
+        return Ok(None);
+    };
+    let path = Path::new(value);
+    let mut normalized = PathBuf::new();
+    for component in path.components() {
+        match component {
+            std::path::Component::RootDir | std::path::Component::Normal(_) => {
+                normalized.push(component)
+            }
+            std::path::Component::CurDir => {}
+            std::path::Component::Prefix(_) | std::path::Component::ParentDir => {
+                bail!("SCCACHE_BASEDIR must not contain `..` or a drive prefix: {value:?}")
+            }
+        }
+    }
+    if !path.is_absolute() || normalized.parent().is_none() {
+        bail!("SCCACHE_BASEDIR must be an absolute directory below the root: {value:?}");
+    }
+    Ok(Some(normalized))
