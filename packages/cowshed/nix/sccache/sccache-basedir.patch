+            }
+            let file = match fs::File::open(&output.path) {
+                Ok(file) => file,
+                Err(e) if output.optional && e.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(e) => return Err(e),
+            };
+            #[cfg(unix)]
+            let mode = {
+                use std::os::unix::fs::MetadataExt;
+                Some(file.metadata()?.mode())
+            };
+            #[cfg(not(unix))]
+            let mode = None;
+            let mut bytes = Vec::new();
+            { file }.read_to_end(&mut bytes)?;
+            let named = match &self.dep_info {
+                Some(DepInfo::Cargo { path, bases }) if *path == output.path => {
+                    let bytes = portable_dep_info(&bytes, bases);
+                    let named = bytes.split(|&byte| byte == b'\n').any(|line| {
