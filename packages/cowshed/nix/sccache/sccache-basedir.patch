+/// last: the most specific base wins, as it does when the key is stripped. A base named both
+/// ways is one base, keyed exactly as either way alone.
+fn remapped_bases(request_base: Option<PathBuf>, cwd_base: Option<PathBuf>) -> Vec<PathBuf> {
+    let mut dirs: Vec<PathBuf> = request_base.into_iter().chain(cwd_base).collect();
+    dirs.sort_by(|a, b| {
+        let (a, b) = (
+            a.as_os_str().as_encoded_bytes(),
+            b.as_os_str().as_encoded_bytes(),
+        );
+        a.len().cmp(&b.len()).then(a.cmp(b))
+    });
+    dirs.dedup();
+    dirs
