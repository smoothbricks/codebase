+/// One of a request's own base directories, and the placeholder that stands for it in a
+/// normalized entry's cargo dep-info. A placeholder names the role, not the directory: the
+/// same role is a different directory at every checkout.
+#[derive(Clone, Debug)]
+pub struct RequestBase {
+    pub placeholder: &'static [u8],
+    pub dir: Vec<u8>,
+}
+
+impl RequestBase {
+    /// The directory `SCCACHE_BASEDIR` names.
+    pub const BASEDIR: &'static [u8] = b"\0SCCACHE_BASEDIR\0";
+    /// The cwd of a `SCCACHE_BASEDIR_CWD=1` request.
+    pub const CWD: &'static [u8] = b"\0SCCACHE_BASEDIR_CWD\0";
+}
+
+/// `dep_info` with every base that starts a path (at a line start, after a space, or after
+/// the `=` of an env-dep) replaced by its placeholder; the longest base wins, and among equal
+/// ones the last. A base holding a byte that make(1) or rustc escapes stays as it is, and so
+/// does every base in a dep-info that already holds a NUL: the check then finds it and binds
+/// the entry to its checkout.
+fn portable_dep_info(dep_info: &[u8], bases: &[RequestBase]) -> Vec<u8> {
+    let bases: Vec<&RequestBase> = bases
+        .iter()
+        .filter(|base| {
+            !base.dir.is_empty()
+                && !base.dir.iter().any(|byte| {
+                    matches!(
+                        byte,
+                        b'\0' | b' ' | b'\t' | b'\n' | b'\r' | b'\\' | b'#' | b'$' | b':' | b'='
+                    )
+                })
+        })
+        .collect();
+    if bases.is_empty() || dep_info.contains(&b'\0') {
+        return dep_info.to_vec();
+    }
+    let mut portable = Vec::with_capacity(dep_info.len());
+    let mut at = 0;
+    while at < dep_info.len() {
+        if at == 0 || matches!(dep_info[at - 1], b'\n' | b' ' | b'\t' | b'=') {
+            let base = bases
+                .iter()
+                .filter(|base| {
+                    dep_info[at..].starts_with(&base.dir)
+                        && matches!(
+                            dep_info.get(at + base.dir.len()),
+                            None | Some(b'/' | b' ' | b'\t' | b'\n' | b'\r' | b':')
+                        )
+                })
+                .max_by_key(|base| base.dir.len());
+            if let Some(base) = base {
+                portable.extend_from_slice(base.placeholder);
+                at += base.dir.len();
+                continue;
+            }
+        }
+        portable.push(dep_info[at]);
+        at += 1;
+    }
+    portable
+}
+
+/// `dep_info` with every placeholder replaced by this request's directory for it.
+fn restore_dep_info(dep_info: &[u8], bases: &[RequestBase]) -> Result<Vec<u8>> {
+    let mut restored = Vec::with_capacity(dep_info.len());
+    let mut rest = dep_info;
+    while let Some(nul) = memchr::memchr(b'\0', rest) {
+        restored.extend_from_slice(&rest[..nul]);
+        rest = &rest[nul..];
+        let Some(base) = bases.iter().find(|base| rest.starts_with(base.placeholder)) else {
+            bail!("the cached dep-info names a base directory this request does not set");
+        };
+        restored.extend_from_slice(&base.dir);
+        rest = &rest[base.placeholder.len()..];
+    }
+    restored.extend_from_slice(rest);
+    Ok(restored)
+}
