+}
+
+/// A dependency list among a compile's outputs, and how the path check reads it.
+#[derive(Clone, Debug)]
+pub enum DepInfo {
+    /// cargo's dep-info. It names the sources and env-dep values at the checkout that
+    /// compiled it, and cargo reads it as such, so a normalized entry holds it portable: each
+    /// of `bases` that starts a path becomes its placeholder, and a hit puts the requesting
+    /// checkout's directory back. Its rule targets are this compile's output paths, which
+    /// every cargo reader ignores, so the check skips them.
+    Cargo {
+        path: PathBuf,
+        bases: Vec<RequestBase>,
+    },
+    /// A C compiler's make depfile. Every lookup writes its own, naming its own checkout, from
+    /// the preprocessing that computes the key, and a hit keeps that one rather than restore
+    /// the entry's (the `is_locally_preprocessed` filter above), so the entry's copy is never
+    /// served and the check skips it.
+    Preprocessed(PathBuf),
+}
