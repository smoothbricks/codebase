+    /// The key a normalizing request looks up and stores under: the normalized key with the
+    /// pin that keeps it honest, unless a marker says this sources' outputs name their
+    /// checkout, in which case the bound key alone. A failed marker read is no reason to stop
+    /// sharing: every normalized entry was checked before it was stored.
+    pub async fn key(
+        storage: &dyn Storage,
+        normalized_key: String,
+        bound_key: String,
+        paths: Vec<Vec<u8>>,
+        dep_info: Option<DepInfo>,
