+/// rustup proxy), so it must remain both the invocation path and cache identity.
+/// Apply this after compiler/proxy detection, which needs the original location.
+pub fn canonicalize_compiler_executable(executable: PathBuf) -> PathBuf {
+    match executable.canonicalize() {
+        Ok(path)
+            if matches!(path.file_name(), Some(name) if executable.file_name() == Some(name)) =>
+        {
+            path
+        }
+        // Preserve the existing compiler lookup policy. The subsequent metadata,
+        // hashing or process operation reports an unavailable executable.
+        _ => executable,
+    }
+}
