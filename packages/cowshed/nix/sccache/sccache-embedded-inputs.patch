+/// The directories the assembler searches, after the cwd, for a relative `.incbin` or
+/// `.include` path, as gcc and clang hand them to it: every driver `-I`, then every `-I`
+/// passed through `-Wa,` or `-Xassembler`, each in command-line order, whatever order the two
+/// kinds were written in. gcc's `asm_options` spec emits `%{I*}` ahead of `%Y`; clang's
+/// assembler job adds `OPT_I_Group` ahead of `CollectArgsForIntegratedAssembler`. Neither
+/// forwards `-iquote`, `-isystem`, `-idirafter` or `CPATH`.
+///
+/// `parsed_args` must come from `parse_arguments` with the same `arg_info`. An argument that
+/// changes the search in a way this does not model is an `Err` naming it.
+pub fn assembler_search_path<S>(
+    parsed_args: &ParsedArguments,
+    arg_info: S,
+) -> std::result::Result<Vec<PathBuf>, String>
+where
+    S: SearchableArgInfo<ArgData>,
+{
+    let mut search_path = vec![];
+    let mut passed: Vec<String> = vec![];
+    let arguments = parsed_args
+        .preprocessor_args
+        .iter()
+        .chain(&parsed_args.common_args)
+        .cloned();
+    for arg in ArgsIter::new(arguments, arg_info) {
+        let arg = arg.map_err(|e| format!("argument parse: {e}"))?;
+        match (arg.flag_str(), arg.get_data()) {
+            (Some("-I"), Some(PreprocessorArgumentPath(dir))) => {
+                let bytes = dir.as_os_str().as_encoded_bytes();
+                // `-I-` splits the quote path; `=` and `$SYSROOT` name the sysroot to the
+                // preprocessor but reach the assembler verbatim; an empty directory is the
+                // root to gas and the cwd to LLVM.
+                if bytes.is_empty()
+                    || bytes == b"-"
+                    || bytes.starts_with(b"=")
+                    || bytes.starts_with(b"$SYSROOT")
+                {
+                    return Err(format!("assembler search through `-I{}`", dir.display()));
+                }
+                search_path.push(dir.clone());
+            }
+            (Some("-Xassembler"), Some(PassThrough(value))) => passed.push(
+                value
+                    .to_str()
+                    .ok_or_else(|| format!("non-UTF-8 `-Xassembler {value:?}`"))?
+                    .to_owned(),
+            ),
+            _ => {
+                if let Argument::UnknownFlag(flag) = &arg {
+                    let flag = flag.to_string_lossy();
+                    if let Some(values) = flag.strip_prefix("-Wa,") {
+                        passed.extend(values.split(',').map(str::to_owned));
+                    } else if [
+                        "--include-directory",
+                        "-Xclangas",
+                        "-working-directory",
+                        "--config",
+                    ]
+                    .iter()
+                    .any(|unmodeled| flag.starts_with(unmodeled))
+                    {
+                        return Err(format!("assembler search through `{flag}`"));
+                    }
+                }
+            }
+        }
+    }
+    // Both drivers flatten every `-Wa,` and `-Xassembler` value into one assembler argv, so
+    // a bare `-I` takes the next value even across flags.
+    let mut passed = passed.into_iter();
+    while let Some(value) = passed.next() {
+        let dir = match value.strip_prefix("-I") {
+            Some("") => passed
+                .next()
+                .ok_or("`-Wa,-I` without a directory".to_owned())?,
+            Some(dir) => dir.to_owned(),
+            None if value.starts_with('@') => {
+                return Err(format!("assembler response file `{value}`"));
+            }
+            None => continue,
+        };
+        if dir.is_empty() {
+            return Err("`-Wa,-I` with an empty directory".to_owned());
+        }
+        search_path.push(PathBuf::from(dir));
+    }
+    Ok(search_path)
+}
