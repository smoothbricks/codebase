@@ -0,0 +1,418 @@
+//! Files an assembler opens by itself. `.incbin` and `.include` name a file the C
+//! preprocessor never reads, so neither the preprocessed text nor direct mode's include list
+//! holds its bytes, and a key built from those alone serves the object of a file's old bytes
+//! after the file changes.
+//!
+//! Directives are found by their names, as an assembler matches them: without regard to case.
+//! A name an assembler macro assembles from pieces (`.inc\()\kind`) is not found; nothing
+//! short of running the assembler finds it.
+
+use crate::compiler::Language;
+use crate::util::{Digest, decode_path};
+use std::collections::HashMap;
+use std::fs::{self, File};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+
+/// How the text a C hasher keys on reaches an assembler.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AssemblerText {
+    /// It is assembler source: `.s` as written, `.S` after preprocessing. Its directives are
+    /// resolved and their files keyed.
+    Source,
+    /// It may hold inline assembly, which the compiler hands its assembler with a search path
+    /// of its own (clang: every `-I`, `-iquote` and `-isystem`, under the sysroot). Its
+    /// directives are refused.
+    Inline,
+    /// No assembler reads it.
+    Opaque,
+}
+
+impl AssemblerText {
+    pub fn of(language: Language) -> Self {
+        match language {
+            Language::Assembler | Language::AssemblerToPreprocess => Self::Source,
+            Language::C
+            | Language::Cxx
+            | Language::GenericHeader
+            | Language::CHeader
+            | Language::CPreprocessed
+            | Language::CxxHeader
+            | Language::CxxPreprocessed
+            | Language::ObjectiveC
+            | Language::ObjectiveCHeader
+            | Language::ObjectiveCPreprocessed
+            | Language::ObjectiveCxx
+            | Language::ObjectiveCxxPreprocessed
+            | Language::ObjectiveCxxHeader
+            | Language::Cuda
+            | Language::CudaFE
+            | Language::Hip
+            | Language::CxxModule => Self::Inline,
+            Language::Ptx | Language::Cubin | Language::Rust => Self::Opaque,
+        }
+    }
+}
+
+/// The content digest of every file the assembler opens for `text`, in the order the text
+/// names them, `.include`d sources followed into; empty when it opens none. `Err` says why
+/// the files cannot be named exactly as the assembler finds them, and the compile must not be
+/// cached. `search_path` is asked only when a relative path needs it.
+pub fn assembler_inputs(
+    text_kind: AssemblerText,
+    text: &[u8],
+    cwd: &Path,
+    search_path: impl FnOnce() -> Result<Vec<PathBuf>, String>,
+) -> Result<Vec<String>, String> {
+    match text_kind {
+        AssemblerText::Opaque => Ok(vec![]),
+        AssemblerText::Inline => match inline_directive(text) {
+            None => Ok(vec![]),
+            Some((at, name)) => Err(format!(
+                "inline assembly `.{}` at byte {at}",
+                String::from_utf8_lossy(name)
+            )),
+        },
+        AssemblerText::Source => {
+            if source_directives(text).next().is_none() {
+                return Ok(vec![]);
+            }
+            let mut reader = SourceReader {
+                cwd,
+                search_path: search_path()?,
+                digests: HashMap::new(),
+                keyed: vec![],
+            };
+            reader.read(text, 0)?;
+            Ok(reader.keyed)
+        }
+    }
+}
+
+const INCBIN: &[u8] = b"incbin";
+const INCLUDE: &[u8] = b"include";
+const ALTMACRO: &[u8] = b"altmacro";
+
+/// A source that includes itself would be followed without end; no real one nests this deep.
+const MAX_INCLUDE_DEPTH: usize = 32;
+
+fn is_symbol_byte(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'$' | b'.')
+}
+
+/// Each `.<name>` in `text` that ends where a symbol would: `(offset of the dot, offset past
+/// the name, name)`.
+fn directive_names<'a>(
+    text: &'a [u8],
+    names: &'static [&'static [u8]],
+) -> impl Iterator<Item = (usize, usize, &'static [u8])> + 'a {
+    memchr::memchr_iter(b'.', text).filter_map(move |dot| {
+        let rest = &text[dot + 1..];
+        names.iter().find_map(|&name| {
+            let end = dot + 1 + name.len();
+            (rest.len() >= name.len()
+                && rest[..name.len()].eq_ignore_ascii_case(name)
+                && text.get(end).is_none_or(|&byte| !is_symbol_byte(byte)))
+            .then_some((dot, end, name))
+        })
+    })
+}
+
+/// The first `.incbin` or `.include` in C text whose operand starts a string inside a string
+/// literal: `.incbin "f"`, `.incbin \"f\"` or `.incbin\t\"f\"`. Whatever precedes the dot is
+/// ignored, because in a literal it is usually the `n` of `\n`.
+fn inline_directive(text: &[u8]) -> Option<(usize, &'static [u8])> {
+    directive_names(text, &[INCBIN, INCLUDE]).find_map(|(dot, end, name)| {
+        let mut rest = &text[end..];
+        loop {
+            match rest {
+                [b' ' | b'\t', tail @ ..] | [b'\\', b't', tail @ ..] => rest = tail,
+                [b'"', ..] | [b'\\', b'"', ..] => return Some((dot, name)),
+                _ => return None,
+            }
+        }
+    })
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Operand<'a> {
+    /// A string with no escape and no character a macro substitutes.
+    Path(&'a [u8]),
+    /// Anything else: an escape, a macro parameter, a symbol, a missing string.
+    Opaque,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct Directive<'a> {
+    at: usize,
+    name: &'static [u8],
+    operand: Operand<'a>,
+}
+
+/// The `.incbin` and `.include` directives of assembler source. A directive starts a
+/// statement, so a dot following a symbol byte (`data.include`) is part of that symbol.
+fn source_directives(text: &[u8]) -> impl Iterator<Item = Directive<'_>> {
+    directive_names(text, &[INCBIN, INCLUDE])
+        .filter(|&(dot, _, _)| dot == 0 || !is_symbol_byte(text[dot - 1]))
+        .map(|(at, end, name)| {
+            let rest = &text[end..];
+            let rest = &rest[rest
+                .iter()
+                .position(|&byte| byte != b' ' && byte != b'\t')
+                .unwrap_or(rest.len())..];
+            let operand = match rest.split_first() {
+                Some((b'"', string)) => match string
+                    .iter()
+                    .position(|&byte| matches!(byte, b'"' | b'\\' | b'$' | b'\n'))
+                {
+                    // `\` escapes or names a macro parameter; `$0` is a Darwin one.
+                    Some(close) if string[close] == b'"' => Operand::Path(&string[..close]),
+                    _ => Operand::Opaque,
+                },
+                _ => Operand::Opaque,
+            };
+            Directive { at, name, operand }
+        })
+}
+
+struct SourceReader<'a> {
+    cwd: &'a Path,
+    search_path: Vec<PathBuf>,
+    /// Digests by resolved path: Bun's blob is named by two `.incbin`s and hashed once.
+    digests: HashMap<PathBuf, String>,
+    keyed: Vec<String>,
+}
+
+impl SourceReader<'_> {
+    fn read(&mut self, text: &[u8], depth: usize) -> Result<(), String> {
+        let mut directives = source_directives(text).peekable();
+        if directives.peek().is_none() {
+            return Ok(());
+        }
+        // In alternate macro mode a parameter is substituted without a `\`, inside strings too.
+        if directive_names(text, &[ALTMACRO]).next().is_some() {
+            return Err("`.altmacro` with a file-reading directive".to_owned());
+        }
+        for directive in directives {
+            let name = String::from_utf8_lossy(directive.name);
+            let Operand::Path(operand) = directive.operand else {
+                return Err(format!(
+                    "`.{name}` at byte {} without a plain string operand",
+                    directive.at
+                ));
+            };
+            let (path, mut file) = self.resolve(operand)?;
+            let unreadable = |e: std::io::Error| format!("reading `{}`: {e}", path.display());
+            if directive.name == INCLUDE {
+                if depth == MAX_INCLUDE_DEPTH {
+                    return Err(format!("`.include` nested past {MAX_INCLUDE_DEPTH}"));
+                }
+                let mut source = vec![];
+                file.read_to_end(&mut source).map_err(unreadable)?;
+                let mut digest = Digest::new();
+                digest.update(&source);
+                self.keyed.push(digest.finish());
+                self.read(&source, depth + 1)?;
+            } else {
+                let digest = match self.digests.get(&path) {
+                    Some(digest) => digest.clone(),
+                    None => {
+                        let digest = Digest::reader_sync(file)
+                            .map_err(|e| format!("reading `{}`: {e}", path.display()))?;
+                        self.digests.insert(path, digest.clone());
+                        digest
+                    }
+                };
+                self.keyed.push(digest);
+            }
+        }
+        Ok(())
+    }
+
+    /// The file both gas (`search_and_open`) and LLVM (`SourceMgr::OpenIncludeFile`) open for
+    /// `operand`: the path as written, against the cwd, then each search directory in turn,
+    /// skipping any path that does not open. Where the two differ this is an `Err`.
+    fn resolve(&self, operand: &[u8]) -> Result<(PathBuf, File), String> {
+        let name = decode_path(operand).map_err(|e| format!("assembler path: {e}"))?;
+        if let Some(found) = opens(&self.cwd.join(&name))? {
+            return Ok(found);
+        }
+        if name.is_absolute() {
+            // LLVM goes on to append it to every search directory; gas stops.
+            return Err(format!("`{}` does not open", name.display()));
+        }
+        for dir in &self.search_path {
+            if let Some(found) = opens(&self.cwd.join(dir).join(&name))? {
+                return Ok(found);
+            }
+        }
+        Err(format!(
+            "`{}` is in neither the cwd nor an assembler `-I` directory",
+            name.display()
+        ))
+    }
+}
+
+/// `Some` for a regular file that opens; `None` for a path that does not open, which both
+/// assemblers pass over; `Err` for one only gas opens, a directory or other non-file.
+fn opens(path: &Path) -> Result<Option<(PathBuf, File)>, String> {
+    match fs::metadata(path) {
+        Err(_) => Ok(None),
+        Ok(meta) if !meta.is_file() => Err(format!("`{}` is not a regular file", path.display())),
+        Ok(_) => Ok(File::open(path).ok().map(|file| (path.to_owned(), file))),
+    }
+}
+
+#[cfg(test)]
+mod test {
+    use super::*;
+
+    fn digest(bytes: &[u8]) -> String {
+        let mut digest = Digest::new();
+        digest.update(bytes);
+        digest.finish()
+    }
+
+    fn source(text: &str) -> Vec<Directive<'_>> {
+        source_directives(text.as_bytes()).collect()
+    }
+
+    #[test]
+    fn source_directives_match_names_as_assemblers_do() {
+        let text = "x: .INCBIN \"a.bin\", 0, 4\n\t.include\t\"b.s\"\n.incbin\"c\"\n";
+        let found: Vec<_> = source(text)
+            .into_iter()
+            .map(|d| (d.name, d.operand))
+            .collect();
+        assert_eq!(
+            found,
+            [
+                (INCBIN, Operand::Path(b"a.bin")),
+                (INCLUDE, Operand::Path(b"b.s")),
+                (INCBIN, Operand::Path(b"c")),
+            ]
+        );
+        // Symbols, longer names and strings are no directives.
+        assert!(source("data.incbin \"a\"\n.incbin2 \"a\"\n.ascii \"x.incbin\"\n").is_empty());
+    }
+
+    #[test]
+    fn source_operands_a_macro_could_rewrite_are_opaque() {
+        for text in [
+            ".incbin \"\\name\"",
+            ".incbin \\name",
+            ".incbin \"$0\"",
+            ".incbin \"a\\\"b\"",
+            ".incbin \"unterminated\n\"",
+            ".incbin",
+        ] {
+            let found = source(text);
+            assert_eq!(found.len(), 1, "{text}");
+            assert_eq!(found[0].operand, Operand::Opaque, "{text}");
+        }
+    }
+
+    #[test]
+    fn inline_directives_are_found_inside_string_literals() {
+        for text in [
+            "asm(\"nop\\n.incbin \\\"f\\\"\");",
+            "asm(\".incbin\\t\\\"f\\\"\");",
+            "asm(R\"(.Include \"f\")\");",
+            "asm(\".incbin\" \" \\\"f\\\"\");",
+        ] {
+            assert!(inline_directive(text.as_bytes()).is_some(), "{text}");
+        }
+        for text in ["range.include(x);", "s.incbin = 1;", "x.included \"f\""] {
+            assert!(inline_directive(text.as_bytes()).is_none(), "{text}");
+        }
+    }
+
+    #[test]
+    fn languages_without_directives_read_nothing() {
+        let cwd = tempfile::tempdir().unwrap();
+        let unused = || -> Result<Vec<PathBuf>, String> { panic!("search path asked for") };
+        assert_eq!(
+            assembler_inputs(AssemblerText::Source, b".text\nnop\n", cwd.path(), unused),
+            Ok(vec![])
+        );
+        assert_eq!(
+            assembler_inputs(AssemblerText::Opaque, b".incbin \"x\"", cwd.path(), unused),
+            Ok(vec![])
+        );
+        assert!(
+            assembler_inputs(
+                AssemblerText::Inline,
+                b"asm(\".incbin \\\"x\\\"\");",
+                cwd.path(),
+                unused
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn resolution_follows_the_assembler_search_order() {
+        let root = tempfile::tempdir().unwrap();
+        let cwd = root.path();
+        for dir in ["first", "second", "isdir/blob.bin"] {
+            fs::create_dir_all(cwd.join(dir)).unwrap();
+        }
+        fs::write(cwd.join("second/blob.bin"), "second").unwrap();
+        let text = b".incbin \"blob.bin\"\n.incbin \"blob.bin\"\n";
+        let search = || Ok(vec![PathBuf::from("first"), PathBuf::from("second")]);
+        let read = || assembler_inputs(AssemblerText::Source, text, cwd, search);
+        assert_eq!(read(), Ok(vec![digest(b"second"); 2]));
+        fs::write(cwd.join("first/blob.bin"), "first").unwrap();
+        assert_eq!(read(), Ok(vec![digest(b"first"); 2]));
+        fs::write(cwd.join("blob.bin"), "cwd").unwrap();
+        assert_eq!(read(), Ok(vec![digest(b"cwd"); 2]));
+
+        // gas opens a directory and fails; LLVM passes over it.
+        let dir = || Ok(vec![PathBuf::from("isdir")]);
+        fs::remove_file(cwd.join("blob.bin")).unwrap();
+        assert!(assembler_inputs(AssemblerText::Source, text, cwd, dir).is_err());
+        // A file found nowhere, an absolute one missing, and an unmodeled search path refuse.
+        let none = || Ok(vec![]);
+        assert!(assembler_inputs(AssemblerText::Source, text, cwd, none).is_err());
+        let absent = format!(".incbin \"{}/absent\"\n", cwd.display());
+        assert!(assembler_inputs(AssemblerText::Source, absent.as_bytes(), cwd, search).is_err());
+        let unmodeled = || Err("unmodeled".to_owned());
+        assert_eq!(
+            assembler_inputs(AssemblerText::Source, text, cwd, unmodeled),
+            Err("unmodeled".to_owned())
+        );
+    }
+
+    #[test]
+    fn include_is_keyed_and_followed() {
+        let root = tempfile::tempdir().unwrap();
+        let cwd = root.path();
+        fs::create_dir(cwd.join("inc")).unwrap();
+        let nested = ".incbin \"blob.bin\"\n";
+        fs::write(cwd.join("inc/nested.s"), nested).unwrap();
+        fs::write(cwd.join("inc/blob.bin"), "blob").unwrap();
+        let search = || Ok(vec![PathBuf::from("inc")]);
+        assert_eq!(
+            assembler_inputs(
+                AssemblerText::Source,
+                b".include \"nested.s\"\n",
+                cwd,
+                search
+            ),
+            Ok(vec![digest(nested.as_bytes()), digest(b"blob")])
+        );
+        fs::write(cwd.join("self.s"), ".include \"self.s\"\n").unwrap();
+        assert!(
+            assembler_inputs(AssemblerText::Source, b".include \"self.s\"\n", cwd, search).is_err()
+        );
+        assert!(
+            assembler_inputs(
+                AssemblerText::Source,
+                b".altmacro\n.include \"inc/nested.s\"\n",
+                cwd,
+                search
+            )
+            .is_err()
+        );
+    }
+}
