+/// Whether `text` holds the identifier `embed` (as in `#embed`, `# embed`, `#/**/embed`) or
+/// `__has_embed`. A match at either edge of `text`, where its neighbor is unknown, counts.
+pub fn finds_embed(text: &[u8]) -> bool {
+    memchr::memmem::find_iter(text, EMBED).any(|at| {
+        let before =
+            at == 0 || !is_identifier_byte(text[at - 1]) || text[..at].ends_with(HAS_EMBED_PREFIX);
+        let after = text
+            .get(at + EMBED.len())
+            .is_none_or(|&byte| !is_identifier_byte(byte));
+        before && after
+    })
