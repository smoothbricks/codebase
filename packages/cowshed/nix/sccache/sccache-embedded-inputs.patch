+        seam.extend_from_slice(&read[..read.len().min(EMBED_WINDOW)]);
+        self.found = finds_embed(&seam) || finds_embed(read);
+        let keep = EMBED_WINDOW - 1;
+        if read.len() >= keep {
+            seam.clear();
+            seam.extend_from_slice(&read[read.len() - keep..]);
+        } else {
+            // The seam is the old tail and all of this short read.
+            seam.drain(..seam.len().saturating_sub(keep));
+        }
+        self.tail = seam;
+    }
+
+    pub fn found(&self) -> bool {
+        self.found
+    }
