+
+/// A key normalized across checkout paths, and the evidence needed to keep it honest.
+///
+/// The normalized key is shared by every checkout of the same sources, so its entry may only
+/// hold outputs that do not name the path they were compiled at. Whether they do is decided
+/// by reading them, after the compile: no key input reveals what a proc macro read from its
+/// environment.
+#[derive(Clone, Debug)]
+pub struct PathPin {
+    /// The paths the normalized key omitted.
+    pub paths: Vec<Vec<u8>>,
+    /// The dep-info output. Its rule targets are this compile's output paths, which every
+    /// cargo reader ignores; only its dependencies count.
+    pub dep_info: Option<PathBuf>,
+    /// The key over every input verbatim, paths included.
+    pub bound_key: String,
+    /// Stored when the outputs name a path: a later lookup that finds it uses its own
+    /// `bound_key` instead of the normalized key.
+    pub marker_key: String,
+}
+
+impl PathPin {
+    pub fn marker_key(normalized_key: &str) -> String {
+        let mut m = crate::util::Digest::new();
+        m.update(b"cowshed-path-bound-marker:");
+        m.update(normalized_key.as_bytes());
+        m.finish()
+    }
+
+    /// The first output that names one of `paths`, if any.
+    fn bound_output(&self, outputs: &[FileObjectSource]) -> std::io::Result<Option<PathBuf>> {
+        // make(1) syntax escapes a space in a dependency path.
+        let escaped: Vec<Vec<u8>> = self
+            .paths
+            .iter()
+            .filter(|path| path.contains(&b' '))
+            .map(|path| {
+                path.iter().fold(Vec::new(), |mut escaped, &byte| {
+                    if byte == b' ' {
+                        escaped.push(b'\\');
+                    }
+                    escaped.push(byte);
+                    escaped
+                })
+            })
+            .collect();
+        let names = |bytes: &[u8]| {
+            self.paths
+                .iter()
+                .chain(&escaped)
+                .any(|path| memchr::memmem::find(bytes, path).is_some())
+        };
+        for output in outputs {
+            let bytes = match fs::read(&output.path) {
+                Ok(bytes) => bytes,
+                Err(e) if output.optional && e.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(e) => return Err(e),
+            };
+            let named = if self.dep_info.as_ref() == Some(&output.path) {
+                bytes
+                    .split(|&byte| byte == b'\n')
+                    .filter(|line| !line.starts_with(b"#"))
+                    .any(|line| {
+                        names(match memchr::memmem::find(line, b": ") {
+                            Some(colon) => &line[colon + 2..],
+                            None => line,
+                        })
+                    })
+            } else {
+                names(&bytes)
+            };
+            if named {
+                return Ok(Some(output.path.clone()));
+            }
+        }
+        Ok(None)
+    }
 }
 
