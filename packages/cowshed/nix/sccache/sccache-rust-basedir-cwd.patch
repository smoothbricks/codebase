+/// `arg` with every `basedirs` entry removed where it starts the argument or follows `=`, the two
+/// places a path sits in a compiler argument (`src/lib.rs`, `-C linker=<path>`). The longest
+/// matching entry wins.
+#[cfg(unix)]
+fn strip_argument_basedirs(arg: &[u8], basedirs: &[Vec<u8>]) -> Vec<u8> {
+    let mut stripped = Vec::with_capacity(arg.len());
+    let mut at = 0;
+    while at < arg.len() {
+        if at == 0 || arg[at - 1] == b'=' {
+            // A whole path component: `/ws` is not a prefix of `/wsx`.
+            if let Some(dir) = basedirs
+                .iter()
+                .filter(|dir| {
+                    !dir.is_empty()
+                        && arg[at..].starts_with(dir)
+                        && (dir.ends_with(b"/")
+                            || matches!(arg.get(at + dir.len()), None | Some(b'/' | b'=')))
+                })
+                .max_by_key(|dir| dir.len())
+            {
+                at += dir.len();
+                continue;
+            }
+        }
+        stripped.push(arg[at]);
+        at += 1;
+    }
+    stripped
