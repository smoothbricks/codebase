{
  "name": "@smoothbricks/cowshed",
  "version": "0.1.9",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "nx run cowshed:test --outputStyle=stream",
    "cowshed": "nx run cowshed:build && node dist/ts/cli.js"
  },
  "bin": {
    "cowshed": "./dist/ts/cli.js"
  },
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "nix"
  ],
  "napi": {
    "binaryName": "cowshed",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "nx": {
    "name": "cowshed",
    "targets": {
      "cli": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "comment": "Runs the TS entry, not dist/bin/darwin-arm64 directly: the trampoline resolves the host's native binary through src/platform.ts, so this works on every arch instead of only Apple Silicon.",
          "cwd": "{projectRoot}",
          "command": "node dist/ts/cli.js {args}"
        }
      },
      "refresh-harnesses": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "bun scripts/refresh-harnesses.ts"
        }
      },
      "cli-arm64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-arm64"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --release --bin cowshed --target aarch64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-arm64"
        }
      },
      "cli-x64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-x64"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --release --bin cowshed --target x86_64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-x64"
        }
      },
      "cli-arm64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "napi-toolchain-arm64-linux"
        ],
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-arm64-gnu"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --release --bin cowshed --target aarch64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-arm64-gnu",
          "env": {
            "CFLAGS_aarch64_unknown_linux_gnu": "-D__ARM_ARCH=8"
          }
        }
      },
      "cli-x64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "napi-toolchain-x64-linux"
        ],
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-x64-gnu"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --release --bin cowshed --target x86_64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-x64-gnu",
          "env": {
            "AR_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-ar",
            "CC_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-gcc",
            "CXX_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-g++",
            "RANLIB_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-ranlib"
          }
        }
      },
      "trampoline-test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "typecheck-tests"
        ],
        "options": {
          "command": "bun test --config=../bunfig.napi-test.toml --timeout=30000 cli-trampoline.test.ts platform.test.ts",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "wire-test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "typecheck-tests"
        ],
        "options": {
          "comment": "Runs from source under the typia transform because the validators under test are the point. Deliberately does NOT depend on cargo-test: wire-fixtures.json is a checked-in file this test reads with readFileSync, produced by no cargo target, and the Rust half (the_committed_wire_corpus_is_what_core_serializes in crates/cowshed-napi/src/wire_contract.rs) pulls the same file in via include_str! so it cannot go stale behind an up-to-date build. The edge expressed 'do not call TS green if Rust disagrees', which cowshed:test already gets by depending on both legs; as a dependsOn it only meant an unrelated Rust failure deleted this target from the run.",
          "command": "bun test --config=../bunfig.toml --timeout=30000 wire-contract.test.ts",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "verify-packaging": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "comment": "dependsOn build so dist/bin exists: the check used to pass by finding nothing.",
          "command": "bun scripts/verify-packaged-bin-bits.ts",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "napi-test",
          "trampoline-test",
          "wire-test",
          "verify-packaging"
        ]
      },
      "integration-apfs": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "cargo test -p cowshed-core --test apfs_integration -- --nocapture"
        }
      },
      "benchmark-apfs": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "cargo run --release -p cowshed-core --bin apfs-benchmark"
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "dependencies": {
    "typia": "14.0.2"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@smoothbricks/lmao": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "@types/node": "~26.1.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/cross-toolchain-arm64-target-aarch64": "1.0.3",
    "@napi-rs/cross-toolchain-x64-target-aarch64": "1.0.3",
    "@napi-rs/cross-toolchain-x64-target-x86_64": "1.0.3"
  },
  "description": "Warm git workspaces: instant isolated copy-on-write workspaces with layered sandboxing (CLI, Rust API, NAPI bindings)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/cowshed"
  }
}
