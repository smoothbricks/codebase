{
  "name": "@smoothbricks/cowshed",
  "version": "0.2.4-next.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "nx run cowshed:test --outputStyle=stream",
    "cowshed": "nx run cowshed:build && bin/cowshed"
  },
  "bin": {
    "cowshed": "./bin/cowshed"
  },
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "nix"
  ],
  "napi": {
    "binaryName": "cowshed",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "nx": {
    "name": "cowshed",
    "targets": {
      "api-generator": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          {
            "target": "cargo-fetch",
            "projects": [
              "@smoothbricks/codebase"
            ]
          }
        ],
        "inputs": [
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/crates/cowshed-api-gen/**/*",
          "cargoToolchain",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh rustc -vV"
          }
        ],
        "outputs": [
          "{workspaceRoot}/target/debug/cowshed-api-gen"
        ],
        "options": {
          "command": "cargo build --frozen -p cowshed-api-gen",
          "cwd": "{workspaceRoot}"
        }
      },
      "api-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "api-generator"
        ],
        "inputs": [
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/crates/cowshed-api-gen/**/*",
          "{projectRoot}/crates/cowshed-core/**/*.rs",
          "{projectRoot}/crates/cowshed-gateway-types/**/*.rs",
          "{projectRoot}/package.json",
          "{workspaceRoot}/biome.json",
          "cargoToolchain",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh rustc -vV"
          }
        ],
        "outputs": [
          "{projectRoot}/src/api.generated.ts",
          "{projectRoot}/src/validators.generated.ts",
          "{projectRoot}/src/native.generated.ts",
          "{projectRoot}/crates/cowshed-napi/src/operations.generated.rs",
          "{projectRoot}/crates/cowshed-core/src/api/served.generated.rs"
        ],
        "options": {
          "command": "target/debug/cowshed-api-gen write packages/cowshed",
          "cwd": "{workspaceRoot}"
        }
      },
      "api-check": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "api-generator"
        ],
        "inputs": [
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/crates/cowshed-api-gen/**/*",
          "{projectRoot}/crates/cowshed-core/**/*.rs",
          "{projectRoot}/crates/cowshed-gateway-types/**/*.rs",
          "{projectRoot}/package.json",
          "{workspaceRoot}/biome.json",
          "{projectRoot}/src/api.generated.ts",
          "{projectRoot}/src/validators.generated.ts",
          "{projectRoot}/src/native.generated.ts",
          "{projectRoot}/crates/cowshed-napi/src/operations.generated.rs",
          "{projectRoot}/crates/cowshed-core/src/api/served.generated.rs",
          "cargoToolchain",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh rustc -vV"
          }
        ],
        "options": {
          "command": "target/debug/cowshed-api-gen check packages/cowshed",
          "cwd": "{workspaceRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "tsc-js": {
        "dependsOn": [
          "...",
          "api-check"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "...",
          "api-check"
        ]
      },
      "typecheck-tests": {
        "dependsOn": [
          "...",
          "api-check"
        ]
      },
      "lint": {
        "dependsOn": [
          "...",
          "api-check"
        ]
      },
      "cli": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "comment": "Runs the package launcher, not dist/bin/darwin-arm64 directly: bin/cowshed resolves the host's native binary, so this works on every arch instead of only Apple Silicon.",
          "cwd": "{projectRoot}",
          "command": "bin/cowshed {args}"
        }
      },
      "refresh-harnesses": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "bun scripts/refresh-harnesses.ts"
        }
      },
      "cli-arm64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "cargoToolchain"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-arm64"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --bin cowshed --target aarch64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-arm64"
        },
        "configurations": {
          "production": {
            "command": "napi build --release --bin cowshed --target aarch64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-arm64"
          }
        }
      },
      "cli-x64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "cargoToolchain"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-x64"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --bin cowshed --target x86_64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-x64"
        },
        "configurations": {
          "production": {
            "command": "napi build --release --bin cowshed --target x86_64-apple-darwin --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/darwin-x64"
          }
        }
      },
      "cli-arm64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "napi-toolchain-arm64-linux"
        ],
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/.cargo/config.toml",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "cargoToolchain"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-arm64-gnu"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --bin cowshed --target aarch64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-arm64-gnu",
          "env": {
            "CFLAGS_aarch64_unknown_linux_gnu": "-D__ARM_ARCH=8"
          }
        },
        "configurations": {
          "production": {
            "command": "napi build --release --bin cowshed --target aarch64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-arm64-gnu"
          }
        }
      },
      "cli-x64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "napi-toolchain-x64-linux"
        ],
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{workspaceRoot}/.cargo/config.toml",
          "{projectRoot}/.cargo/config.toml",
          "!{projectRoot}/**/target/**",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "cargoToolchain"
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-x64-gnu"
        ],
        "options": {
          "cwd": "packages/cowshed",
          "command": "napi build --bin cowshed --target x86_64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-x64-gnu",
          "env": {
            "AR_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-ar",
            "CC_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-gcc",
            "CXX_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-g++",
            "RANLIB_x86_64_unknown_linux_gnu": "x86_64-unknown-linux-gnu-ranlib"
          }
        },
        "configurations": {
          "production": {
            "command": "napi build --release --bin cowshed --target x86_64-unknown-linux-gnu --use-napi-cross --manifest-path crates/cowshed-cli/Cargo.toml --package cowshed-cli --output-dir dist/bin/linux-x64-gnu"
          }
        }
      },
      "launcher-test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "//": "dependsOn ^build so lmao/dist exists: bunfig.napi-test.toml preloads ../../lmao/dist/ts/bun/trace-preload.js, and without the edge a cold cache runs this target before lmao:build.",
        "dependsOn": [
          "^build",
          "typecheck-tests"
        ],
        "options": {
          "command": "bun test --config=../bunfig.napi-test.toml --timeout=30000 launcher.test.ts platform.test.ts",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "wire-fixtures": {
        "executor": "nx:run-commands",
        "cache": true,
        "//": "The napi wire corpus is DERIVED from cowshed-core's DTOs: regenerating it is a build step with declared inputs, never a recipe an author has to remember after changing a DTO. Runs ahead of cargo-test-compile because crates/cowshed-napi includes the file with include_str!, so the corpus has to be current before any test binary compiles it in. The Rust assertion that the committed file equals what core serializes stays as the proof; this target is what keeps it true.",
        "dependsOn": [
          "api-check",
          {
            "target": "cargo-fetch",
            "projects": [
              "@smoothbricks/codebase"
            ]
          }
        ],
        "inputs": [
          "{workspaceRoot}/Cargo.toml",
          "{workspaceRoot}/Cargo.lock",
          "{projectRoot}/crates/cowshed-core/**/*.rs",
          "{projectRoot}/crates/cowshed-core/Cargo.toml",
          "{projectRoot}/crates/cowshed-napi/**/*.rs",
          "{projectRoot}/crates/cowshed-napi/Cargo.toml",
          "{workspaceRoot}/biome.json",
          "!{projectRoot}/**/target/**",
          "cargoToolchain"
        ],
        "outputs": [
          "{projectRoot}/src/wire-fixtures.json"
        ],
        "options": {
          "command": "COWSHED_WIRE_FIXTURES=write cargo --frozen test -p cowshed-napi --quiet the_committed_wire_corpus_is_what_core_serializes && biome format --write src/wire-fixtures.json",
          "cwd": "packages/cowshed"
        }
      },
      "capability-probe-warmup": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "dependsOn": [
          {
            "target": "cargo-test-archive",
            "projects": [
              "@smoothbricks/codebase"
            ]
          }
        ],
        "options": {
          "comment": "Build prerequisite for the cowshed-core exceptional shards, not a test. public_api_contracts' capability probe cargo-checks its case crates against cowshed-core, and its dependency build exceeded the 120s test bound on a cold hosted arm64 runner. This runs the ignored capability_probe_dependencies_check from the same archive with empty case crates, warming the shared target/ before the bounded shards. The 600s budget is a build budget, as in wire-warmup. cache:false is required because target/ is not an Nx output: a cached skip on a fresh runner would leave the probe cold. It reuses the generated runners' content-keyed extraction under Cargo's target directory rather than `--archive-file`, which unpacks into a fresh $TMPDIR/nextest-archive-* that a killed run never removes.",
          "command": "extracted=\"$(node node_modules/@smoothbricks/nx-plugin/dist/bin/smoo-nx-nextest-extract.js .cache/nextest/archive.tar.zst)\" && cargo --frozen nextest run --binaries-metadata \"$extracted/target/nextest/binaries-metadata.json\" --cargo-metadata \"$extracted/target/nextest/cargo-metadata.json\" --target-dir-remap \"$extracted/target\" --workspace-remap . -E 'package(cowshed-core) and test(=capability_probe_dependencies_check)' --run-ignored only --no-tests=fail --user-config-file none",
          "cwd": ".",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        }
      },
      "cargo-test-cowshed-core-exceptions-shard1": {
        "dependsOn": [
          "...",
          "capability-probe-warmup"
        ]
      },
      "cargo-test-cowshed-core-exceptions-shard2": {
        "dependsOn": [
          "...",
          "capability-probe-warmup"
        ]
      },
      "cargo-test-cowshed-core-exceptions-shard3": {
        "dependsOn": [
          "...",
          "capability-probe-warmup"
        ]
      },
      "cargo-test-cowshed-core-exceptions-shard4": {
        "dependsOn": [
          "...",
          "capability-probe-warmup"
        ]
      },
      "cargo-test-cowshed-core-exceptions-shard5": {
        "dependsOn": [
          "...",
          "capability-probe-warmup"
        ]
      },
      "wire-warmup": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "dependsOn": [
          "api-check"
        ],
        "options": {
          "comment": "Build prerequisite for wire-test, not a test: the first load of each project through the compiler preload compiles the typia native plugin, which takes minutes on a cold Go cache and would blow wire-test's 120s bound. The 600s budget here is a build budget, not a test timeout increase: it bounds the compilation while staying inside the workflow's overall bound, and fails loudly instead of hanging release. cache:false is load-bearing — the ttsc plugin cache lives outside Nx outputs, so a cached skip on a fresh runner would run the test cold and hang it again. Uses the same compiler preload specifier as bunfig.toml; the trace preload is absent on purpose (its setup calls afterAll(), which throws outside `bun test`) and adds no plugin key (measured: harness import alone builds the full runtime key set).",
          "command": "bun --preload @smoothbricks/lmao/bun/preload scripts/warm-ttsc-plugins.mjs",
          "cwd": "packages/cowshed",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        }
      },
      "wire-test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "typecheck-tests",
          "wire-fixtures",
          "wire-warmup"
        ],
        "options": {
          "comment": "Runs from source under the typia transform because the validators under test are the point. Depends on wire-fixtures (the corpus is a generated output, current by construction) and not on cargo-test: the Rust half proves the same corpus through include_str!, and cowshed:test already joins both legs; a cargo-test edge here only meant an unrelated Rust failure deleted this target from the run.",
          "command": "bun test --config=../bunfig.toml --timeout=30000 wire-contract.test.ts exec.test.ts",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "verify-packaging": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "comment": "dependsOn build so dist/bin exists: the check used to pass by finding nothing.",
          "command": "bun scripts/verify-packaged-bin-bits.ts",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "napi-test",
          "launcher-test",
          "wire-test",
          "verify-packaging"
        ]
      },
      "host-controller-test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "dependsOn": [
          {
            "target": "cargo-test-archive",
            "projects": [
              "@smoothbricks/codebase"
            ]
          }
        ],
        "inputs": [
          "default",
          "{workspaceRoot}/packages/nx-plugin/nextest.toml",
          {
            "dependentTasksOutputFiles": "**/archive.tar.zst",
            "transitive": false
          }
        ],
        "options": {
          "comment": "Run from an unsandboxed host-controller shell, never cowshed exec: controller fixtures require file-link, deliberately denied to every workspace supervisor and child. Runs ignored host_controller_ tests from the owning workspace's prebuilt nextest archive, whose output bytes are hashed inputs. Compilation is cached and paid by cargo-test-archive before this run; the private runtime TMPDIR cannot change the compiled environment, so the 120s guard covers only extraction and tests.",
          "command": "bun packages/cowshed/scripts/host-controller-test.ts",
          "cwd": ".",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "integration-apfs": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "cargo test -p cowshed-core --test apfs_integration -- --nocapture"
        }
      },
      "benchmark-apfs": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "packages/cowshed",
          "command": "cargo run --release -p cowshed-core --bin apfs-benchmark"
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "dependencies": {
    "typia": "14.0.6"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@smoothbricks/lmao": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/cross-toolchain-arm64-target-aarch64": "1.0.3",
    "@napi-rs/cross-toolchain-x64-target-aarch64": "1.0.3",
    "@napi-rs/cross-toolchain-x64-target-x86_64": "1.0.3"
  },
  "description": "Warm git workspaces: instant isolated copy-on-write workspaces with layered sandboxing (CLI, Rust API, NAPI bindings)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/cowshed"
  }
}
