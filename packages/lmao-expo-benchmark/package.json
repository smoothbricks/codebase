{
  "name": "@smoothbricks/lmao-expo-benchmark",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "bun run prepare:web-wasm && expo start --web",
    "prepare:web-wasm": "nx run lmao-expo-benchmark:prepare-web-wasm",
    "test": "nx run lmao-expo-benchmark:test --outputStyle=stream"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.3",
    "@smoothbricks/lmao": "workspace:*",
    "expo": "57.0.4",
    "fast-text-encoding": "1.0.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "0.86.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@smoothbricks/lmao-ttsc": "workspace:*",
    "@ttsc/metro": "0.34.1",
    "@types/react": "^19.2.14",
    "ttsc": "0.34.1",
    "typescript": "^6.0.3"
  },
  "nx": {
    "name": "lmao-expo-benchmark",
    "sourceRoot": "packages/lmao-expo-benchmark/src",
    "projectType": "application",
    "namedInputs": {
      "pluginScenarioSources": [
        "{workspaceRoot}/packages/lmao/benchmarks/plugin-scenario/**/*"
      ]
    },
    "targets": {
      "typecheck": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "...",
          "^build"
        ],
        "inputs": [
          "...",
          {
            "externalDependencies": [
              "bun-lock:packages/lmao-expo-benchmark"
            ]
          },
          "default",
          "pluginScenarioSources",
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "options": {
          "command": "ttsc --noEmit -p tsconfig.json",
          "cwd": "{projectRoot}",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        }
      },
      "typecheck-tests": {
        "inputs": [
          {
            "externalDependencies": [
              "bun-lock:packages/lmao-expo-benchmark"
            ]
          },
          "default",
          "pluginScenarioSources",
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ]
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "...",
          "^build"
        ],
        "inputs": [
          "...",
          "default",
          "pluginScenarioSources",
          "bunToolchain"
        ],
        "options": {
          "command": "bun test --timeout=0 src",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "lint": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "inputs": [
          "...",
          {
            "externalDependencies": [
              "bun-lock:packages/lmao-expo-benchmark"
            ]
          },
          "default",
          "^dependencyDefault"
        ],
        "dependsOn": [
          "...",
          "typecheck"
        ],
        "options": {
          "command": "biome check .",
          "cwd": "{projectRoot}",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        }
      },
      "prepare-web-wasm": {
        "//": "The one producer of public/allocator.wasm, the allocator the web page fetches beside index.html (src/platform-runtime.web.ts) and hands to the thread runtime as a compiled module, since a bundled page cannot resolve it from import.meta.url. It stages this checkout's dev build, the one lmao's source authority loads (packages/nx-plugin/README.md, Cargo profiles), so the web script and every export-browser flavour share this one declared write instead of copying inline.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/allocator.wasm"
          }
        ],
        "dependsOn": [
          "^build",
          {
            "projects": [
              "lmao"
            ],
            "target": "cargo-wasm"
          }
        ],
        "outputs": [
          "{projectRoot}/{options.outputDir}/allocator.wasm"
        ],
        "options": {
          "command": "mkdir -p {args.outputDir} && cp ../lmao/.cache/wasm-dev/allocator.wasm {args.outputDir}/allocator.wasm",
          "cwd": "{projectRoot}",
          "outputDir": "public"
        }
      },
      "export-browser": {
        "//": "Each configuration exports its flavour to its own dist/web/<transform>-<mode>/: outputs interpolate the LMAO_BENCH_TRANSFORM and LMAO_BENCH_MODE its env sets and the command expands the same pair, so what Nx declares is what expo export writes and no two configurations share a directory. A flavour is never implicit (metro.config.cjs refuses a missing pair), so defaultConfiguration names off-steady, and the command's :? refuses an env without the pair before expo export deletes any directory.",
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "default",
          "pluginScenarioSources",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          {
            "externalDependencies": [
              "bun-lock:packages/lmao-expo-benchmark"
            ]
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "dependsOn": [
          "...",
          "^build",
          "prepare-web-wasm"
        ],
        "outputs": [
          "{projectRoot}/dist/web/{options.env.LMAO_BENCH_TRANSFORM}-{options.env.LMAO_BENCH_MODE}/"
        ],
        "options": {
          "command": "out=\"dist/web/${LMAO_BENCH_TRANSFORM:?}-${LMAO_BENCH_MODE:?}\" && bun expo export --platform web --output-dir \"$out\" --clear --max-workers 1",
          "cwd": "{projectRoot}",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        },
        "defaultConfiguration": "off-steady",
        "configurations": {
          "off-cold": {
            "env": {
              "LMAO_BENCH_MODE": "cold",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "off-steady": {
            "env": {
              "LMAO_BENCH_MODE": "steady",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "off-diagnostic": {
            "env": {
              "LMAO_BENCH_MODE": "diagnostic",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "on-cold": {
            "env": {
              "LMAO_BENCH_MODE": "cold",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          },
          "on-steady": {
            "env": {
              "LMAO_BENCH_MODE": "steady",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          },
          "on-diagnostic": {
            "env": {
              "LMAO_BENCH_MODE": "diagnostic",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          }
        }
      },
      "export-hermes": {
        "//": "The same layout under dist/headless/<transform>-<mode>/: the bytecode bundle, its source map and the assets all go to the one directory the env pair names, and defaultConfiguration is off-steady for the same reason.",
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "default",
          "pluginScenarioSources",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          {
            "externalDependencies": [
              "bun-lock:packages/lmao-expo-benchmark"
            ]
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "dependsOn": [
          "...",
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist/headless/{options.env.LMAO_BENCH_TRANSFORM}-{options.env.LMAO_BENCH_MODE}/"
        ],
        "options": {
          "command": "out=\"dist/headless/${LMAO_BENCH_TRANSFORM:?}-${LMAO_BENCH_MODE:?}\" && bun expo export:embed --entry-file headless-bootstrap.js --platform android --dev false --minify true --bytecode --reset-cache --max-workers 1 --bundle-output \"$out/lmao-benchmark.hbc\" --sourcemap-output \"$out/lmao-benchmark.hbc.map\" --assets-dest \"$out\"",
          "cwd": "{projectRoot}",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        },
        "defaultConfiguration": "off-steady",
        "configurations": {
          "off-cold": {
            "env": {
              "LMAO_BENCH_MODE": "cold",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "off-steady": {
            "env": {
              "LMAO_BENCH_MODE": "steady",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "off-diagnostic": {
            "env": {
              "LMAO_BENCH_MODE": "diagnostic",
              "LMAO_BENCH_TRANSFORM": "off"
            }
          },
          "on-cold": {
            "env": {
              "LMAO_BENCH_MODE": "cold",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          },
          "on-steady": {
            "env": {
              "LMAO_BENCH_MODE": "steady",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          },
          "on-diagnostic": {
            "env": {
              "LMAO_BENCH_MODE": "diagnostic",
              "LMAO_BENCH_TRANSFORM": "on"
            }
          }
        }
      }
    }
  }
}
