{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "exclude": [],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.spec.ts",
    "src/test-suite-tracer.ts"
  ],
  "references": [
    {
      "path": "../lmao/tsconfig.lib.json"
    },
    {
      "path": "../lmao-ttsc/tsconfig.lib.json"
    }
  ]
}
