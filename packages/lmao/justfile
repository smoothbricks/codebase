# lmao Rust task runner. Install: cargo install just cargo-mutants
# (cd packages/lmao first, or `just -f packages/lmao/justfile <task>`)

# Fast tier: unit + property tests at default case counts (runs the green suite).
test:
    cargo test -p 'lmao-*'

# Heavy property tier: elevated proptest cases over the same mandatory suite.
proptest-heavy cases="10000":
    PROPTEST_CASES={{cases}} cargo test -p 'lmao-*' --release

# Mutation tier (see mutants.toml for arid/exclusion policy).
mutants:
    cargo mutants -p lmao-core -p lmao-arena -p lmao-arrow -p lmao-macros -p lmao-query

# wasm32 ABI build for the TypeScript host. Needs: rustup target add wasm32-unknown-unknown
#
# The lmao-wasm crate's [lib] name IS `allocator`, so this only lifts cargo's
# output out of `target/` — the one placement cargo cannot do itself. It does
# not rename: producer and consumer agree on `allocator.wasm` end to end.
wasm:
    RUSTFLAGS="-C link-arg=--import-memory" cargo build -p lmao-wasm --target wasm32-unknown-unknown --release
    @mkdir -p dist
    @cp ../../target/wasm32-unknown-unknown/release/allocator.wasm dist/allocator.wasm
    @ls -la dist/allocator.wasm

# Overhead gates placeholder (criterion). Real gate: traced-vs-untraced ≤20%
# throughput delta + zero-alloc test (tests/alloc_gate.rs, currently TDD-red).
bench:
    cargo bench -p lmao-core

check:
    cargo check -p 'lmao-*' --all-targets
    cargo clippy -p 'lmao-*' --all-targets -- -D warnings

