{
  "name": "@smoothbricks/lmao",
  "version": "0.3.8-next.0",
  "type": "module",
  "sideEffects": [
    "./dist/vocabulary/register/v1.js",
    "./src/vocabulary/register/v1.ts",
    "./dist/lib/span-buffer/aot/v1.js",
    "./src/lib/span-buffer/aot/v1.ts"
  ],
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    },
    "./span-buffer/aot/v1": {
      "types": "./dist/ts/lib/span-buffer/aot/v1.d.ts",
      "development": "./src/lib/span-buffer/aot/v1.ts",
      "import": "./dist/ts/lib/span-buffer/aot/v1.js",
      "default": "./dist/ts/lib/span-buffer/aot/v1.js"
    },
    "./vocabulary/register/v1": {
      "types": "./dist/ts/vocabulary/register/v1.d.ts",
      "development": "./src/vocabulary/register/v1.ts",
      "import": "./dist/ts/vocabulary/register/v1.js",
      "default": "./dist/ts/vocabulary/register/v1.js"
    },
    "./node": {
      "types": "./dist/ts/node.d.ts",
      "development": "./src/node.ts",
      "import": "./dist/ts/node.js",
      "default": "./dist/ts/node.js"
    },
    "./es": {
      "types": "./dist/ts/es.d.ts",
      "development": "./src/es.ts",
      "import": "./dist/ts/es.js",
      "default": "./dist/ts/es.js"
    },
    "./react-native": {
      "types": "./dist/ts/react-native.d.ts",
      "development": "./src/react-native.ts",
      "import": "./dist/ts/react-native.js",
      "default": "./dist/ts/react-native.js"
    },
    "./wasm": {
      "types": "./dist/ts/wasm.d.ts",
      "development": "./src/wasm.ts",
      "import": "./dist/ts/wasm.js",
      "default": "./dist/ts/wasm.js"
    },
    "./cloudflare": {
      "types": "./dist/ts/cloudflare.d.ts",
      "development": "./src/cloudflare.ts",
      "import": "./dist/ts/cloudflare.js",
      "default": "./dist/ts/cloudflare.js"
    },
    "./tracers": {
      "types": "./dist/ts/lib/tracers/index.d.ts",
      "development": "./src/lib/tracers/index.ts",
      "import": "./dist/ts/lib/tracers/index.js",
      "default": "./dist/ts/lib/tracers/index.js"
    },
    "./errors": {
      "types": "./dist/ts/lib/errors/index.d.ts",
      "development": "./src/lib/errors/index.ts",
      "import": "./dist/ts/lib/errors/index.js",
      "default": "./dist/ts/lib/errors/index.js"
    },
    "./errors/Blocked": {
      "types": "./dist/ts/lib/errors/Blocked.d.ts",
      "development": "./src/lib/errors/Blocked.ts",
      "import": "./dist/ts/lib/errors/Blocked.js",
      "default": "./dist/ts/lib/errors/Blocked.js"
    },
    "./errors/RetriesExhausted": {
      "types": "./dist/ts/lib/errors/RetriesExhausted.d.ts",
      "development": "./src/lib/errors/RetriesExhausted.ts",
      "import": "./dist/ts/lib/errors/RetriesExhausted.js",
      "default": "./dist/ts/lib/errors/RetriesExhausted.js"
    },
    "./errors/CodeError": {
      "types": "./dist/ts/lib/errors/CodeError.d.ts",
      "development": "./src/lib/errors/CodeError.ts",
      "import": "./dist/ts/lib/errors/CodeError.js",
      "default": "./dist/ts/lib/errors/CodeError.js"
    },
    "./errors/retry-policy": {
      "types": "./dist/ts/lib/errors/retry-policy.d.ts",
      "development": "./src/lib/errors/retry-policy.ts",
      "import": "./dist/ts/lib/errors/retry-policy.js",
      "default": "./dist/ts/lib/errors/retry-policy.js"
    },
    "./errors/Transient": {
      "types": "./dist/ts/lib/errors/Transient.d.ts",
      "development": "./src/lib/errors/Transient.ts",
      "import": "./dist/ts/lib/errors/Transient.js",
      "default": "./dist/ts/lib/errors/Transient.js"
    },
    "./sqlite": {
      "types": "./dist/ts/lib/sqlite/index.d.ts",
      "development": "./src/lib/sqlite/index.ts",
      "import": "./dist/ts/lib/sqlite/index.js",
      "default": "./dist/ts/lib/sqlite/index.js"
    },
    "./sqlite/node": {
      "types": "./dist/ts/lib/sqlite/sqlite-node.d.ts",
      "development": "./src/lib/sqlite/sqlite-node.ts",
      "import": "./dist/ts/lib/sqlite/sqlite-node.js",
      "default": "./dist/ts/lib/sqlite/sqlite-node.js"
    },
    "./testing": {
      "types": "./dist/ts/testing.d.ts",
      "development": "./src/testing.ts",
      "import": "./dist/ts/testing.js",
      "default": "./dist/ts/testing.js"
    },
    "./testing/bun": {
      "types": "./dist/ts/lib/testing/bun-harness.d.ts",
      "bun": "./src/lib/testing/bun-harness.ts",
      "development": "./src/lib/testing/bun-harness.ts",
      "import": "./dist/ts/lib/testing/bun-harness.js",
      "default": "./dist/ts/lib/testing/bun-harness.js"
    },
    "./testing/vitest": {
      "types": "./dist/ts/lib/testing/vitest-harness.d.ts",
      "development": "./src/lib/testing/vitest-harness.ts",
      "import": "./dist/ts/lib/testing/vitest-harness.js",
      "default": "./dist/ts/lib/testing/vitest-harness.js"
    },
    "./bun/thread-ffi": {
      "bun": "./src/bun/threadSpanBufferFfi.ts",
      "development": "./src/bun/threadSpanBufferFfi.ts",
      "default": "./dist/ts/bun/threadSpanBufferFfi.js"
    },
    "./bun/preload": {
      "bun": "./src/bun/preload.ts",
      "development": "./src/bun/preload.ts",
      "default": "./dist/ts/bun/preload.js"
    },
    "./bun/trace-preload": {
      "bun": "./src/bun/trace-preload.ts",
      "development": "./src/bun/trace-preload.ts",
      "default": "./dist/ts/bun/trace-preload.js"
    }
  },
  "files": [
    "dist",
    "src",
    "crates/**/*.rs",
    "crates/**/Cargo.toml",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml",
    "justfile",
    "!**/*.tsbuildinfo",
    "!crates/**/target/**"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@neophi/sieve-cache": "^1.5.0",
    "@smoothbricks/arrow-builder": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "@uwdata/flechette": "^2.3.0",
    "tslib": "^2.8.1",
    "typia": "14.0.2"
  },
  "scripts": {
    "bench": "bun run benchmarks/*.bench.ts",
    "bench:wasm": "bun run benchmarks/js-vs-wasm.bench.ts",
    "build:wasm": "nx run lmao:cargo-wasm",
    "test": "nx run lmao:test --outputStyle=stream"
  },
  "nx": {
    "sourceRoot": "packages/lmao/src",
    "projectType": "library",
    "targets": {
      "lint": {},
      "cargo-lint": {
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-lint-cross": {
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-compile": {
        "inputs": [
          "{projectRoot}/**/*.rs",
          "{projectRoot}/**/Cargo.toml",
          "{projectRoot}/**/Cargo.lock",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-arrow": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-arrow/**/*.rs",
          "{projectRoot}/crates/lmao-arrow/Cargo.toml",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-ffi-dylib": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/crates/lmao-ffi-dylib/**/*.rs",
          "{projectRoot}/crates/lmao-ffi-dylib/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-query": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-arrow/**/*.rs",
          "{projectRoot}/crates/lmao-arrow/Cargo.toml",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/crates/lmao-query/**/*.rs",
          "{projectRoot}/crates/lmao-query/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-wasm": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-arena/**/*.rs",
          "{projectRoot}/crates/lmao-arena/Cargo.toml",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/crates/lmao-wasm/**/*.rs",
          "{projectRoot}/crates/lmao-wasm/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-core": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/crates/lmao-macros/**/*.rs",
          "{projectRoot}/crates/lmao-macros/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "cargo-test-lmao-macros": {
        "inputs": [
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/crates/lmao-core/**/*.rs",
          "{projectRoot}/crates/lmao-core/Cargo.toml",
          "{projectRoot}/crates/lmao-macros/**/*.rs",
          "{projectRoot}/crates/lmao-macros/Cargo.toml",
          "{projectRoot}/**/.cargo/config.toml",
          "{projectRoot}/scripts/*.sh",
          "!{projectRoot}/**/target/**",
          "lmaoGitRevision"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "...",
          "cargo-test",
          "cargo-thread-ffi"
        ],
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "cargo-wasm": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/crates/**/*.rs",
          "{projectRoot}/crates/**/Cargo.toml",
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/.cargo/config.toml",
          "{projectRoot}/justfile",
          "{projectRoot}/src/lib/schema/systemSchema.ts",
          "{projectRoot}/src/lib/capacityTuning.ts",
          "lmaoGitRevision"
        ],
        "outputs": [
          "{projectRoot}/dist/allocator.wasm"
        ],
        "options": {
          "command": "just wasm",
          "cwd": "{projectRoot}"
        }
      },
      "cargo-thread-ffi": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/crates/**/*.rs",
          "{projectRoot}/crates/**/Cargo.toml",
          "{projectRoot}/Cargo.toml",
          "{projectRoot}/Cargo.lock",
          "{projectRoot}/.cargo/config.toml",
          "lmaoGitRevision"
        ],
        "outputs": [
          "{projectRoot}/target/release/liblmao_ffi_dylib.dylib",
          "{projectRoot}/target/release/liblmao_ffi_dylib.so",
          "{projectRoot}/target/release/lmao_ffi_dylib.dll"
        ],
        "options": {
          "command": "cargo build -p lmao-ffi-dylib --release",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "lmao"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/lmao"
  }
}
