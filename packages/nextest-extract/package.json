{
  "name": "@smoothbricks/nextest-extract",
  "version": "0.0.2-0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts/nextest-binaries.js",
  "module": "./dist/ts/nextest-binaries.js",
  "types": "./dist/ts/nextest-binaries.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/nextest-binaries.d.ts",
      "import": "./dist/ts/nextest-binaries.js",
      "default": "./dist/ts/nextest-binaries.js"
    }
  },
  "bin": {
    "smoo-nx-nextest-binaries": "./dist/ts/bin/smoo-nx-nextest-binaries.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run nextest-extract:test --outputStyle=stream"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@scriptc/runtime-darwin-arm64": "0.4.4",
    "@scriptc/runtime-darwin-x64": "0.4.4",
    "@scriptc/runtime-linux-arm64-musl": "0.4.4",
    "@scriptc/runtime-linux-x64-musl": "0.4.4",
    "@smoothbricks/cargo-retain": "workspace:*",
    "scriptc": "0.4.4"
  },
  "nx": {
    "name": "nextest-extract",
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/nextest-extract"
  }
}
