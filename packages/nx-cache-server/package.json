{
  "name": "@smoothbricks/nx-cache-server",
  "version": "0.1.3-next.0",
  "type": "module",
  "sideEffects": false,
  "description": "Nx-compatible task archive server with atomic never-replace publication, and filesystem SIEVE retention.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/nx-cache-server"
  },
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "bin": {
    "nx-cache-server": "./dist/ts/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    }
  },
  "files": [
    "dist/ts",
    "dist/server",
    "src",
    "!**/*.test.ts",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@smoothbricks/lmao": "workspace:*",
    "typia": "14.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "nx run nx-cache-server:test --outputStyle=stream"
  },
  "nx": {
    "name": "nx-cache-server",
    "tags": [
      "npm:public"
    ],
    "targets": {
      "lint": {},
      "test-warmup": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": false,
        "options": {
          "comment": "Build prerequisite for test, not a test: each TypeScript project test loads through the compiler preload compiles its own typia native plugin key, which takes minutes on a cold Go cache and would blow test's 180s idle bound before any test finishes (canonical 39038263857: build still active at idle expiry, compiler at 116.8% CPU, no test named). The 600s budget here is a build budget, not a test timeout increase. cache:false is load-bearing — the ttsc plugin cache lives outside Nx outputs, so a cached skip on a fresh runner would run the test cold again. Follows wire-warmup in packages/cowshed/package.json; uses the same compiler preload specifier as bunfig.toml. The trace preload is absent on purpose (its setup calls afterAll(), which throws outside `bun test`), so the script imports the LMAO test harness it loads instead: that module routes through LMAO's own project, a second plugin key (publish 39079862820 built it cold inside test).",
          "command": "bun --preload @smoothbricks/lmao/bun/preload scripts/warm-ttsc-plugins.mjs",
          "cwd": "{projectRoot}",
          "timeoutMs": 600000,
          "killAfterMs": 10000
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "test-warmup"
        ],
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "build": {
        "dependsOn": [
          "...",
          "bundle"
        ]
      },
      "bundle": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "externalDependencies": [
              "bun-lock:packages/nx-cache-server"
            ]
          },
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/server/nx-cache-server.js"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --target=bun src/main.ts --outfile dist/server/nx-cache-server.js"
        }
      }
    }
  }
}
