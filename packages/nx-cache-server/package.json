{
  "name": "@smoothbricks/nx-cache-server",
  "version": "0.1.3-next.0",
  "type": "module",
  "sideEffects": false,
  "description": "Nx-compatible task archive server with atomic never-replace publication, and filesystem SIEVE retention.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/nx-cache-server"
  },
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "bin": {
    "nx-cache-server": "./dist/ts/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    }
  },
  "files": [
    "dist/ts",
    "dist/server",
    "src",
    "!**/*.test.ts",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@smoothbricks/lmao": "workspace:*",
    "typia": "15.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "nx run nx-cache-server:test --outputStyle=stream"
  },
  "nx": {
    "name": "nx-cache-server",
    "tags": [
      "npm:public",
      "wiring:enforced"
    ],
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "//": "Its typia plugin warmth is the fixture segment below: each TypeScript project the test loads through the compiler preload compiles its own native plugin key, minutes on a cold Go cache, which blew the 180s progress bound before any test finished (canonical 39038263857: build still active at idle expiry, compiler at 116.8% CPU, no test named). The plugin cache lives outside Nx outputs, so the warming cannot be an Nx cache entry of its own; as this task's build interval under a 600s budget it runs exactly when the test executes, and a cache hit warms nothing. Uses the same compiler preload specifier as bunfig.toml; the trace preload is absent on purpose (its setup calls afterAll(), which throws outside bun test).",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "fixtureCommand": "bun --preload @smoothbricks/lmao/bun/preload scripts/warm-ttsc-plugins.mjs",
          "fixtureTimeoutMs": 600000,
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "build": {
        "dependsOn": [
          "...",
          "bundle"
        ]
      },
      "bundle": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "externalDependencies": [
              "bun-lock:packages/nx-cache-server"
            ]
          },
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "outputs": [
          "{projectRoot}/dist/server/nx-cache-server.js"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --target=bun src/main.ts --outfile dist/server/nx-cache-server.js"
        }
      }
    }
  }
}
