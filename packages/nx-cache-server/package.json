{
  "name": "@smoothbricks/nx-cache-server",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Nx-compatible task archive server with labelled principals, atomic never-replace publication, and filesystem SIEVE retention.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/nx-cache-server"
  },
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "bin": {
    "nx-cache-server": "./dist/ts/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    }
  },
  "files": [
    "dist/ts",
    "dist/bin",
    "src",
    "!**/*.test.ts",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@smoothbricks/lmao": "workspace:*",
    "typia": "14.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "nx run nx-cache-server:test --outputStyle=stream"
  },
  "nx": {
    "name": "nx-cache-server",
    "tags": [
      "npm:public"
    ],
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "bun-arm64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-arm64/nx-cache-server"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --compile --target=bun-darwin-arm64 src/main.ts --outfile dist/bin/darwin-arm64/nx-cache-server"
        }
      },
      "bun-x64-macos": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/bin/darwin-x64/nx-cache-server"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --compile --target=bun-darwin-x64 src/main.ts --outfile dist/bin/darwin-x64/nx-cache-server"
        }
      },
      "bun-arm64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-arm64/nx-cache-server"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --compile --target=bun-linux-arm64 src/main.ts --outfile dist/bin/linux-arm64/nx-cache-server"
        }
      },
      "bun-x64-linux": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/__tests__/**",
          "{projectRoot}/package.json",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun -e 'console.log(Bun.version, Bun.revision)'"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/bin/linux-x64/nx-cache-server"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile dist/bin/linux-x64/nx-cache-server"
        }
      }
    }
  }
}
