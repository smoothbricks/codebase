# Worktrees inherit the real project .envrc once, then stop. The same file is
# checked out inside .jcode-worktrees, so continuing after source_up_if_exists
# would run the devenv setup twice while sandbox blocks access to tooling/.
case "$PWD" in
  */.jcode-worktrees/*)
    ;;
  *)
    source_up_if_exists
    ;;
esac

watch_file tooling/direnv/envrc.sh

# devenv asks the Cachix API for the signing key of each binary cache it pulls
# from (`cachix.pull`, `devenv` by default) unless cachix_trusted_keys.json in
# its home already records it. A cowshed sandbox gives every workspace a private
# data home and no route to that API (devenv's TLS client rejects the gateway's
# certificate), so each activation there asked again and was refused. The key is
# public and fixed, so it is recorded before devenv starts; an existing file is
# devenv's and stays as it is.
devenv_keys="${DEVENV_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/devenv}/cachix_trusted_keys.json"
if [ ! -e "$devenv_keys" ]; then
  mkdir -p "$(dirname "$devenv_keys")"
  printf '{\n  "devenv": "devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw="\n}\n' >"$devenv_keys.$$"
  mv -f "$devenv_keys.$$" "$devenv_keys"
fi
unset devenv_keys

# Load local extensions and overrides from the project root (the gitignored
# .envrc-local); capture it before we cd into tooling/direnv, since envrc.sh
# leaves us there and a bare relative path would resolve under tooling/direnv.
project_root="$PWD"
local_override="$project_root/.envrc-local"
# The origin checkout publishes a credential-free evaluated shell inside its
# private .devenv; cowshed clones inherit it copy-on-write. No sibling-owned
# writable cache can provide shell code. Changed inputs evaluate in place.
watch_file tooling/direnv/inherited-devenv.ts
smoo_inherited_devenv() {
  bun "$project_root/tooling/direnv/inherited-devenv.ts" "$project_root" "$@"
}
# bun comes from this workspace's own evaluated devenv profile. A checkout
# entered for the first time has none yet, and neither cowshed nor the host
# lends one, so devenv then evaluates in place.
if has bun; then
  DEVENV_BIN=smoo_inherited_devenv
fi
cd tooling/direnv
. envrc.sh
unset -f smoo_inherited_devenv
unset DEVENV_BIN

# Re-enter exactly when shell entry has something to do. The scripts it runs
# decide what that is, and setup-environment.ts records the files its install
# stamps cover — lockfiles, every workspace manifest, bunfig.toml, patches,
# every pyproject.toml — one per line in $DEVENV_STATE/install-inputs. A shell
# direnv keeps loaded, or a pool of them gated on direnv's watches, then
# reinstalls after a pull or a manifest edit and stays put otherwise.
install_inputs=()
if [ -f "${DEVENV_STATE:-}/install-inputs" ]; then
  while IFS= read -r install_input; do
    install_inputs+=("$install_input")
  done <"$DEVENV_STATE/install-inputs"
fi
watch_file \
  "$project_root/tooling/direnv/repo-path" \
  "$project_root/tooling/direnv/shared-caches.sh" \
  "$project_root/tooling/direnv/nx-socket-dir.sh" \
  "$project_root/tooling/direnv/setup-environment.ts" \
  "$project_root/tooling/direnv/secret-references.ts" \
  "$project_root/tooling/direnv/toolchain-stamp.ts" \
  ${install_inputs[@]+"${install_inputs[@]}"}

source_env_if_exists "$local_override"
