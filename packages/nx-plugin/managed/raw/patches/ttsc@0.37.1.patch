@@ -0,0 +1,50 @@
+package driver
+
+import (
+  "bytes"
+  "errors"
+  "fmt"
+  "os"
+  "path/filepath"
+
+  "github.com/microsoft/typescript-go/shim/ast"
+  shimcompiler "github.com/microsoft/typescript-go/shim/compiler"
+)
+
+// WithdrawnDiagnosticsPathEnv names the file the driver records the
+// diagnostics its linked DiagnosticPlugins withdrew into. ttsc sets it for
+// every native plugin command it runs: when that command fails, ttsc checks the
+// project again with the stock compiler, which loads no plugin, and reports
+// only what the failed command did not print. A withdrawn diagnostic was never
+// printed, so without this record that pass would report it as an error.
+const WithdrawnDiagnosticsPathEnv = "TTSC_WITHDRAWN_DIAGNOSTICS_PATH"
+
+// recordWithdrawnDiagnostics appends withdrawn to the file
+// WithdrawnDiagnosticsPathEnv names, rendered as WritePrettyDiagnostics renders
+// the diagnostics a host prints, so ttsc reads both with one parser and compares
+// them by one identity. Every host computes its diagnostics through the
+// Program, so the record does not depend on how a host prints them. A pass
+// appends, so a host that asks for diagnostics more than once keeps every
+// withdrawal. It records nothing when the variable is unset or nothing was
+// withdrawn; an absent file records that nothing was. The path must be
+// absolute.
+func (p *Program) recordWithdrawnDiagnostics(withdrawn []*ast.Diagnostic) error {
+  path := os.Getenv(WithdrawnDiagnosticsPathEnv)
+  if path == "" || len(withdrawn) == 0 {
+    return nil
+  }
+  if !filepath.IsAbs(path) {
+    return fmt.Errorf("withdrawn diagnostics path must be absolute: %q", path)
+  }
+  var rendered bytes.Buffer
+  WritePrettyDiagnostics(&rendered, p.convertProgramDiagnostics(shimcompiler.SortAndDeduplicateDiagnostics(withdrawn)), p.TSProgram.GetCurrentDirectory())
+  file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0o600)
+  if err != nil {
+    return fmt.Errorf("withdrawn diagnostics: %w", err)
+  }
+  _, writeErr := file.Write(rendered.Bytes())
+  if err := errors.Join(writeErr, file.Close()); err != nil {
+    return fmt.Errorf("withdrawn diagnostics: %w", err)
+  }
+  return nil
+}
