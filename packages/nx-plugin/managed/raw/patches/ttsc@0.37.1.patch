+type sessionTestPlugin struct {
+	applyCalls int
+	lastProg   *Program
+	emitProg   *Program
+	failText   string
+}
+
+func (p *sessionTestPlugin) ApplyProgram(prog *Program, ctx PluginContext) error {
+	p.applyCalls++
+	p.lastProg = ctx.Program
+	for _, sf := range prog.TSProgram.SourceFiles() {
+		if !sf.IsDeclarationFile && p.failText != "" && strings.Contains(sf.Text(), p.failText) {
+			return errors.New("forbidden marker present")
+		}
+	}
+	return nil
+}
+
+func (p *sessionTestPlugin) EmitTransform(ctx PluginContext) (PluginTransform, error) {
+	p.emitProg = ctx.Program
+	return func(ec *shimprinter.EmitContext, sf *shimast.SourceFile) *shimast.SourceFile {
+		var visitor *shimast.NodeVisitor
+		visitor = ec.NewNodeVisitor(func(node *shimast.Node) *shimast.Node {
+			if node.Kind == shimast.KindStringLiteral && node.Text() == "before-emit" {
+				return ec.Factory.NewStringLiteral("after-emit", shimast.TokenFlagsNone)
+			}
+			return visitor.VisitEachChild(node)
+		})
+		return visitor.VisitSourceFile(sf)
+	}, nil
+}
