+		t.Fatalf("generation 2 ApplyProgram should succeed after fixing file: %v", err)
+	}
+	if plugin.applyCalls != 2 {
+		t.Fatalf("expected ApplyProgram to re-run on generation 2, calls=%d", plugin.applyCalls)
+	}
