+package driver
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	shimast "github.com/microsoft/typescript-go/shim/ast"
+	shimcompiler "github.com/microsoft/typescript-go/shim/compiler"
+	shimprinter "github.com/microsoft/typescript-go/shim/printer"
+	shimtspath "github.com/microsoft/typescript-go/shim/tspath"
+)
+
+type sessionTestPlugin struct {
+	applyCalls int
+	lastProg   *Program
+	emitProg   *Program
+	failText   string
+}
+
+func (p *sessionTestPlugin) ApplyProgram(prog *Program, ctx PluginContext) error {
+	p.applyCalls++
+	p.lastProg = ctx.Program
+	for _, sf := range prog.TSProgram.SourceFiles() {
+		if !sf.IsDeclarationFile && p.failText != "" && strings.Contains(sf.Text(), p.failText) {
+			return errors.New("forbidden marker present")
+		}
+	}
+	return nil
+}
+
+func (p *sessionTestPlugin) EmitTransform(ctx PluginContext) (PluginTransform, error) {
+	p.emitProg = ctx.Program
+	return func(ec *shimprinter.EmitContext, sf *shimast.SourceFile) *shimast.SourceFile {
+		var visitor *shimast.NodeVisitor
+		visitor = ec.NewNodeVisitor(func(node *shimast.Node) *shimast.Node {
+			if node.Kind == shimast.KindStringLiteral && node.Text() == "before-emit" {
+				return ec.Factory.NewStringLiteral("after-emit", shimast.TokenFlagsNone)
+			}
+			return visitor.VisitEachChild(node)
+		})
+		return visitor.VisitSourceFile(sf)
+	}, nil
+}
+
+func TestSessionApplyResetsLinkedPluginsAndExposesProgramToEmitTransform(t *testing.T) {
+	savedRegistry := append([]any(nil), pluginRegistry...)
+	t.Cleanup(func() { pluginRegistry = savedRegistry })
+
+	plugin := &sessionTestPlugin{failText: "FORBIDDEN"}
+	pluginRegistry = []any{plugin}
+	payload, _ := json.Marshal([]PluginEntry{{Name: "session-test", Stage: "transform", Config: map[string]any{}}})
+	t.Setenv(LinkedPluginsEnv, string(payload))
+
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	mainPath := filepath.Join(root, "main.ts")
+	if err := os.WriteFile(filepath.Join(root, "tsconfig.json"), []byte(`{"compilerOptions":{"target":"ES2022","module":"ESNext","strict":true,"outDir":"out"},"files":["main.ts"]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(mainPath, []byte(`export const label = "FORBIDDEN";`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
