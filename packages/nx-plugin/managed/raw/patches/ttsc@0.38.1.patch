+	transforms, err := session.Program().LinkedEmitTransforms()
+	if err != nil || len(transforms) != 1 {
+		t.Fatalf("LinkedEmitTransforms: len=%d err=%v", len(transforms), err)
+	}
+	if plugin.emitProg != session.Program() {
+		t.Fatal("PluginContext.Program in EmitTransform did not match the active Program")
+	}
