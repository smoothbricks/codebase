+// the plugin rewrites before emit or a transform's output, which TypeScript has
+// no grammar for. The checker judges the parse tree before any ProgramPlugin
+// applies, so its refusal of such a construct names nothing the output holds,
+// and every lane that gates on the program's diagnostics (check, emit, a
+// transform) would refuse the dialect it was built to compile.
+// LoweredDiagnostics names those refusals among the diagnostics it is given;
+// the driver drops exactly the ones it names that it gave, and reports every
+// other diagnostic as it would without the plugin.
+type DiagnosticPlugin interface {
+  // LoweredDiagnostics returns the diagnostics, among those given, whose cause
+  // this plugin's ProgramPlugin removes. It reads the parse tree the checker
+  // judged, before any ProgramPlugin applies.
+  LoweredDiagnostics(*Program, PluginContext, []*ast.Diagnostic) []*ast.Diagnostic
