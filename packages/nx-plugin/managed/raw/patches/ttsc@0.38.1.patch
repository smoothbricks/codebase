diff --git a/utility/linkedemit/emit_transform_test.go b/utility/linkedemit/emit_transform_test.go
new file mode 100644
index 0000000..2840828
--- /dev/null
+++ b/utility/linkedemit/emit_transform_test.go
@@ -0,0 +1,104 @@
+// Package linkedemit holds the utility host's linked emit-transform test in a
+// test binary of its own. The linked-plugin registry is process-wide and a
+// manifest entry selects the registration at its own position; the utility
+// package's check-serve tests register their probes at positions 0 and 1, so a
+// plugin registered beside them could only be reached through those probes.
+package linkedemit
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	shimast "github.com/microsoft/typescript-go/shim/ast"
+	shimprinter "github.com/microsoft/typescript-go/shim/printer"
+
+	"github.com/samchon/ttsc/packages/ttsc/driver"
+	"github.com/samchon/ttsc/packages/ttsc/utility"
+)
+
+type utilityEmitTransformPlugin struct{}
+
+func init() {
+	driver.RegisterPlugin(utilityEmitTransformPlugin{})
+}
+
+func (utilityEmitTransformPlugin) EmitTransform(ctx driver.PluginContext) (driver.PluginTransform, error) {
+	if ctx.Program == nil {
+		return nil, nil
+	}
+	return func(ec *shimprinter.EmitContext, sf *shimast.SourceFile) *shimast.SourceFile {
+		var visitor *shimast.NodeVisitor
+		visitor = ec.NewNodeVisitor(func(node *shimast.Node) *shimast.Node {
+			if node.Kind == shimast.KindStringLiteral && node.Text() == "utility-before" {
+				return ec.Factory.NewStringLiteral("utility-after", shimast.TokenFlagsNone)
+			}
+			return visitor.VisitEachChild(node)
+		})
+		return visitor.VisitSourceFile(sf)
+	}, nil
+}
+
+func TestUtilityTransformAndServeRunLinkedEmitTransforms(t *testing.T) {
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "tsconfig.json"), []byte(`{"compilerOptions":{"target":"ES2022","module":"ESNext","strict":true},"files":["entry.ts"]}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "entry.ts"), []byte("export const value = \"utility-before\";\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	payload, _ := json.Marshal([]driver.PluginEntry{{Name: "utility-emit-test", Stage: "transform", Config: map[string]any{}}})
+	baseArgs := []string{"--cwd", root, "--tsconfig", "tsconfig.json", "--plugins-json", string(payload)}
+
+	t.Run("transform", func(t *testing.T) {
+		var stdout, stderr bytes.Buffer
+		status := utility.RunTransformWithIO(baseArgs, &stdout, &stderr)
+		if status != 0 {
+			t.Fatalf("RunTransformWithIO status=%d stderr=%s", status, stderr.String())
+		}
+		var env struct {
+			TypeScript map[string]string          `json:"typescript"`
+			SourceMaps map[string]json.RawMessage `json:"sourceMaps"`
+		}
+		if err := json.Unmarshal(stdout.Bytes(), &env); err != nil {
+			t.Fatalf("decode transform output: %v\n%s", err, stdout.String())
+		}
+		if got := env.TypeScript["entry.ts"]; !strings.Contains(got, `"utility-after"`) || strings.Contains(got, `"utility-before"`) {
+			t.Fatalf("transform output did not apply linked emit transform:\n%s", got)
+		}
+		if len(env.SourceMaps["entry.ts"]) == 0 {
+			t.Fatalf("expected source map for entry.ts after linked emit transform")
+		}
+	})
+
+	t.Run("serve", func(t *testing.T) {
+		in := strings.NewReader("{\"file\":\"entry.ts\"}\n{\"update\":\"entry.ts\",\"content\":\"export const value = \\\"utility-before\\\";\\nexport const n = 2;\\n\"}\n{\"file\":\"entry.ts\"}\n")
+		var out bytes.Buffer
+		status := utility.RunServe(in, &out, baseArgs)
+		if status != 0 {
+			t.Fatalf("RunServe status=%d out=%s", status, out.String())
+		}
+		lines := strings.Split(strings.TrimSpace(out.String()), "\n")
+		if len(lines) != 3 {
+			t.Fatalf("expected 3 serve responses, got %d:\n%s", len(lines), out.String())
+		}
+		for _, idx := range []int{0, 2} {
+			var resp struct {
+				Found      bool   `json:"found"`
+				TypeScript string `json:"typescript"`
+			}
+			if err := json.Unmarshal([]byte(lines[idx]), &resp); err != nil {
+				t.Fatalf("decode serve line %d: %v", idx, err)
+			}
+			if !resp.Found || !strings.Contains(resp.TypeScript, `"utility-after"`) || strings.Contains(resp.TypeScript, `"utility-before"`) {
+				t.Fatalf("serve line %d missing linked emit transform:\n%s", idx, resp.TypeScript)
+			}
+		}
+	})
+}
