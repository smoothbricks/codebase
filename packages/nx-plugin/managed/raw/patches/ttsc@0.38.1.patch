+type loweringDiagnosticPlugin struct{}
+
+func (loweringDiagnosticPlugin) LoweredDiagnostics(_ *Program, _ PluginContext, diagnostics []*shimast.Diagnostic) []*shimast.Diagnostic {
+	var lowered []*shimast.Diagnostic
+	for _, d := range diagnostics {
+		if d.Code() == 1103 {
+			lowered = append(lowered, d)
+		}
+	}
+	return lowered
+}
+
+func (loweringDiagnosticPlugin) EmitTransform(_ PluginContext) (PluginTransform, error) {
+	return func(ec *shimprinter.EmitContext, sf *shimast.SourceFile) *shimast.SourceFile {
+		var visitor *shimast.NodeVisitor
+		visitor = ec.NewNodeVisitor(func(node *shimast.Node) *shimast.Node {
+			if node.Kind == shimast.KindForOfStatement && node.AsForInOrOfStatement().AwaitModifier != nil {
+				return ec.Factory.NewEmptyStatement()
+			}
+			return visitor.VisitEachChild(node)
+		})
+		return visitor.VisitSourceFile(sf)
+	}, nil
+}
