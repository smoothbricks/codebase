{
  "name": "@smoothbricks/nx-plugin",
  "version": "0.4.16-next.0",
  "type": "module",
  "sideEffects": false,
  "main": "./loader.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./loader.js",
      "default": "./loader.js"
    },
    "./version-actions": {
      "types": "./dist/version-actions.d.cts",
      "require": "./dist/version-actions.cjs",
      "default": "./dist/version-actions.cjs"
    },
    "./bounded-test-policy": {
      "types": "./dist/bounded-test-policy.d.ts",
      "development": "./src/bounded-test-policy.ts",
      "import": "./dist/bounded-test-policy.js",
      "default": "./dist/bounded-test-policy.js"
    },
    "./workspace-config-policy": {
      "types": "./dist/workspace-config-policy.d.ts",
      "development": "./src/workspace-config-policy.ts",
      "import": "./dist/workspace-config-policy.js",
      "default": "./dist/workspace-config-policy.js"
    },
    "./release-config-policy": {
      "types": "./dist/release-config-policy.d.ts",
      "development": "./src/release-config-policy.ts",
      "import": "./dist/release-config-policy.js",
      "default": "./dist/release-config-policy.js"
    },
    "./package-target-policy": {
      "types": "./dist/package-target-policy.d.ts",
      "development": "./src/package-target-policy.ts",
      "import": "./dist/package-target-policy.js",
      "default": "./dist/package-target-policy.js"
    },
    "./typecheck-test-policy": {
      "types": "./dist/typecheck-test-policy.d.ts",
      "development": "./src/typecheck-test-policy.ts",
      "import": "./dist/typecheck-test-policy.js",
      "default": "./dist/typecheck-test-policy.js"
    },
    "./ensure-built": {
      "types": "./dist/ensure-built.d.ts",
      "development": "./src/ensure-built.ts",
      "import": "./dist/ensure-built.js",
      "default": "./dist/ensure-built.js"
    },
    "./cross-check-policy": {
      "types": "./dist/cross-check-policy.d.ts",
      "development": "./src/cross-check-policy.ts",
      "import": "./dist/cross-check-policy.js",
      "default": "./dist/cross-check-policy.js"
    },
    "./cargo-toolchain-policy": {
      "types": "./dist/cargo-toolchain-policy.d.ts",
      "development": "./src/cargo-toolchain-policy.ts",
      "import": "./dist/cargo-toolchain-policy.js",
      "default": "./dist/cargo-toolchain-policy.js"
    },
    "./workspace-manifest": {
      "types": "./dist/workspace-manifest.d.ts",
      "development": "./src/workspace-manifest.ts",
      "import": "./dist/workspace-manifest.js",
      "default": "./dist/workspace-manifest.js"
    },
    "./workspace-package-policy": {
      "types": "./dist/workspace-package-policy.d.ts",
      "development": "./src/workspace-package-policy.ts",
      "import": "./dist/workspace-package-policy.js",
      "default": "./dist/workspace-package-policy.js"
    },
    "./deploy-policy": {
      "types": "./dist/deploy-policy.d.ts",
      "development": "./src/deploy-policy.ts",
      "import": "./dist/deploy-policy.js",
      "default": "./dist/deploy-policy.js"
    },
    "./managed-assets": {
      "types": "./dist/managed-assets.d.ts",
      "development": "./src/managed-assets.ts",
      "import": "./dist/managed-assets.js",
      "default": "./dist/managed-assets.js"
    },
    "./managed-files/generator": {
      "types": "./dist/managed-files/generator.d.ts",
      "development": "./src/managed-files/generator.ts",
      "import": "./dist/managed-files/generator.js",
      "default": "./dist/managed-files/generator.js"
    },
    "./managed-files/managed-content": {
      "types": "./dist/managed-files/managed-content.d.ts",
      "development": "./src/managed-files/managed-content.ts",
      "import": "./dist/managed-files/managed-content.js",
      "default": "./dist/managed-files/managed-content.js"
    },
    "./managed-files/tree": {
      "types": "./dist/managed-files/tree.d.ts",
      "development": "./src/managed-files/tree.ts",
      "import": "./dist/managed-files/tree.js",
      "default": "./dist/managed-files/tree.js"
    },
    "./managed-files/files": {
      "types": "./dist/managed-files/files.d.ts",
      "development": "./src/managed-files/files.ts",
      "import": "./dist/managed-files/files.js",
      "default": "./dist/managed-files/files.js"
    },
    "./managed-files/paths": {
      "types": "./dist/managed-files/paths.d.ts",
      "development": "./src/managed-files/paths.ts",
      "import": "./dist/managed-files/paths.js",
      "default": "./dist/managed-files/paths.js"
    },
    "./managed-files/ci-workflow": {
      "types": "./dist/managed-files/ci-workflow.d.ts",
      "development": "./src/managed-files/ci-workflow.ts",
      "import": "./dist/managed-files/ci-workflow.js",
      "default": "./dist/managed-files/ci-workflow.js"
    },
    "./managed-files/publish-workflow": {
      "types": "./dist/managed-files/publish-workflow.d.ts",
      "development": "./src/managed-files/publish-workflow.ts",
      "import": "./dist/managed-files/publish-workflow.js",
      "default": "./dist/managed-files/publish-workflow.js"
    },
    "./managed-files/github-runs-on": {
      "types": "./dist/managed-files/github-runs-on.d.ts",
      "development": "./src/managed-files/github-runs-on.ts",
      "import": "./dist/managed-files/github-runs-on.js",
      "default": "./dist/managed-files/github-runs-on.js"
    },
    "./managed-files/pr-preview-cleanup-workflow": {
      "types": "./dist/managed-files/pr-preview-cleanup-workflow.d.ts",
      "development": "./src/managed-files/pr-preview-cleanup-workflow.ts",
      "import": "./dist/managed-files/pr-preview-cleanup-workflow.js",
      "default": "./dist/managed-files/pr-preview-cleanup-workflow.js"
    },
    "./managed-files/private-npm-policy": {
      "types": "./dist/managed-files/private-npm-policy.d.ts",
      "development": "./src/managed-files/private-npm-policy.ts",
      "import": "./dist/managed-files/private-npm-policy.js",
      "default": "./dist/managed-files/private-npm-policy.js"
    },
    "./managed-files/context": {
      "types": "./dist/managed-files/context.d.ts",
      "development": "./src/managed-files/context.ts",
      "import": "./dist/managed-files/context.js",
      "default": "./dist/managed-files/context.js"
    }
  },
  "bin": {
    "smoo-nx-exec": "./dist/bin/smoo-nx-exec.js",
    "smoo-nx-cargo-hash": "./dist/bin/smoo-nx-cargo-hash.js"
  },
  "generators": "./generators.json",
  "executors": "./executors.json",
  "scripts": {
    "test": "nx run nx-plugin:test --outputStyle=stream"
  },
  "nx": {
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000.0
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "nx-plugin"
  },
  "files": [
    "dist",
    "src",
    "nextest.toml",
    "README.md",
    "loader.js",
    "generators.json",
    "executors.json",
    "!**/*.tsbuildinfo",
    "managed"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/nx-plugin"
  },
  "dependencies": {
    "@nx/js": "latest",
    "nx": "latest",
    "smol-toml": "^1.6.1",
    "tslib": "^2.8.1",
    "typia": "14.0.2",
    "make-synchronized": "^0.8.0",
    "prettier": "^3.6.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@smoothbricks/lmao": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "fast-check": "^4.4.0"
  }
}
