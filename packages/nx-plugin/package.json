  "bin": {
    "smoo-nx-exec": "./dist/bin/smoo-nx-exec.js",
    "smoo-nx-cargo-hash": "./dist/bin/smoo-nx-cargo-hash.js",
    "smoo-nx-cargo-toolchain": "./dist/bin/smoo-nx-cargo-toolchain.js",
    "smoo-nx-nextest-timings": "./dist/bin/smoo-nx-nextest-timings.js",
    "smoo-nx-bound-failures": "./dist/bin/smoo-nx-bound-failures.js",
    "smoo-nx-test-walks": "./dist/bin/smoo-nx-test-walks.js",
    "smoo-nx-test-clocks": "./dist/bin/smoo-nx-test-clocks.js",
    "smoo-nx-publish": "./dist/bin/smoo-nx-publish.js",
    "smoo-nx-forbidden-spellings": "./dist/bin/smoo-nx-forbidden-spellings.js"
  },
  "generators": "./generators.json",
  "executors": "./executors.json",
  "scripts": {
    "test": "nx run nx-plugin:test --outputStyle=stream"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "...",
          "copy-nx-publish-assets"
        ]
      },
      "copy-nx-publish-assets": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/build_volume/cache_adapter.js",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/build_volume/nx_publish.js",
          {
            "externalDependencies": []
          }
        ],
        "outputs": [
          "{projectRoot}/runtime/nx-publish/"
        ],
        "options": {
          "command": "asset_source=../cowshed/crates/cowshed-core/src/build_volume; if [ -e runtime/nx-publish ]; then rm -r runtime/nx-publish; fi && mkdir -p runtime/nx-publish && cp \"$asset_source/cache_adapter.js\" \"$asset_source/nx_publish.js\" runtime/nx-publish/",
          "cwd": "{projectRoot}"
        }
      },
      "test-nx-publish": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node --version"
          },
          {
            "dependentTasksOutputFiles": "**/dist/bin/smoo-nx-publish.js",
            "transitive": true
          },
          {
            "dependentTasksOutputFiles": "**/dist/nx-publish.js",
            "transitive": true
          },
          {
            "dependentTasksOutputFiles": "**/runtime/nx-publish/*.js",
            "transitive": true
          }
        ],
        "dependsOn": [
          "...",
          "tsc-js",
          "copy-nx-publish-assets",
          "typecheck-tests"
        ],
        "options": {
          "command": "bun test --timeout=0 ./src/__tests__/nx-publish.cases.ts ./src/__tests__/nx-publish-bin.cases.ts",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "lint": {},
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "test-shard1",
          "test-shard2",
          "test-shard3",
          "test-shard4",
          "test-host",
          "test-pool-silence",
          "test-nx-publish",
          "test-results-runtime"
        ]
      },
      "closed-results-runtime-bundle": {
        "executor": "nx:run-commands",
        "cache": true,
        "metadata": {
          "smooTaskKind": "test"
        },
        "dependsOn": [
          "tsc-js",
          "typecheck-tests"
        ],
        "inputs": [
          "{projectRoot}/src/__tests__/test-results-runtime.entry.ts",
          "{projectRoot}/package.json",
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json",
          "bunToolchain",
          {
            "externalDependencies": [
              "bun-lock:packages/nx-plugin"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/dist/**/*.js",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/.cache/test-results-runtime/"
        ],
        "options": {
          "command": "bun build src/__tests__/test-results-runtime.entry.ts --target=bun --conditions=production --outfile=.cache/test-results-runtime/bundle.mjs",
          "cwd": "{projectRoot}"
        }
      },
      "test-results-runtime": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "...",
          "closed-results-runtime-bundle"
        ],
        "inputs": [
          "...",
          "bunToolchain",
          {
            "externalDependencies": [
              "bun-lock:packages/nx-plugin"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/test-results-runtime/bundle.mjs",
            "transitive": false
          }
        ],
        "options": {
          "command": "bun .cache/test-results-runtime/bundle.mjs",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-pool-silence": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/port_zero.cjs"
        ],
        "options": {
          "command": "bun test --timeout=0 ./src/executors/bounded-exec/__tests__/cpu-pool.silence.ts",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "cargo-stream-archive": {
        "executor": "nx:run-commands",
        "cache": true,
        "metadata": {
          "smooTaskKind": "test"
        },
        "inputs": [
          "{projectRoot}/test-fixtures/stream-witness/**/*",
          "!{projectRoot}/test-fixtures/stream-witness/target/**/*",
          "{workspaceRoot}/.cargo/config",
          "{workspaceRoot}/.cargo/config.toml",
          "cargoToolchain",
          {
            "externalDependencies": []
          }
        ],
        "outputs": [
          "{projectRoot}/.cache/test-stream/archive.tar.zst"
        ],
        "options": {
          "command": "mkdir -p .cache/test-stream && cargo --frozen nextest archive --manifest-path test-fixtures/stream-witness/Cargo.toml --archive-file .cache/test-stream/archive.tar.zst --user-config-file none",
          "cwd": "{projectRoot}"
        }
      },
      "test-shard1": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/port_zero.cjs",
          {
            "dependentTasksOutputFiles": "**/test-stream/archive.tar.zst",
            "transitive": false
          }
        ],
        "dependsOn": [
          "...",
          "^build",
          "build",
          "cargo-stream-archive"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=1/4 --path-ignore-patterns='**/*-host.test.ts'",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard2": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/port_zero.cjs",
          {
            "dependentTasksOutputFiles": "**/test-stream/archive.tar.zst",
            "transitive": false
          }
        ],
        "dependsOn": [
          "...",
          "^build",
          "build",
          "cargo-stream-archive"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=2/4 --path-ignore-patterns='**/*-host.test.ts'",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard3": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/port_zero.cjs",
          {
            "dependentTasksOutputFiles": "**/test-stream/archive.tar.zst",
            "transitive": false
          }
        ],
        "dependsOn": [
          "...",
          "^build",
          "build",
          "cargo-stream-archive"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=3/4 --path-ignore-patterns='**/*-host.test.ts'",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-shard4": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/packages/cowshed/crates/cowshed-core/src/port_zero.cjs",
          {
            "dependentTasksOutputFiles": "**/test-stream/archive.tar.zst",
            "transitive": false
          }
        ],
        "dependsOn": [
          "...",
          "^build",
          "build",
          "cargo-stream-archive"
        ],
        "options": {
          "command": "bun test --timeout=0 --timings=test-timings.json --shard=4/4 --path-ignore-patterns='**/*-host.test.ts'",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-host": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          "{workspaceRoot}/devenv.lock",
          "{workspaceRoot}/tooling/direnv/devenv.lock",
          "{workspaceRoot}/packages/cowshed/bin/**/*",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          }
        ],
        "dependsOn": [
          "...",
          {
            "projects": [
              "cowshed"
            ],
            "target": "cli-native"
          },
          {
            "projects": [
              "cowshed"
            ],
            "target": "ram-fixture"
          }
        ],
        "options": {
          "command": "bun test --timeout=0 ./src/executors/bounded-exec/ram-temp-host.test.ts ./src/executors/bounded-exec/executor-host.test.ts ./src/executors/bounded-exec/go-progress-host.test.ts ./src/executors/bounded-exec/cargo-progress-host.test.ts ./src/nx-daemon-stop-host.test.ts ./src/nx-daemon-watch-stream-host.test.ts ./src/executors/bounded-exec/hang-diagnostics-host.test.ts",
          "cwd": "{projectRoot}",
          "env": {
            "COWSHED_EXECUTABLE": "{workspaceRoot}/packages/cowshed/bin/cowshed"
          },
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "implicitDependencies": [
      "!cowshed"
    ],
    "name": "nx-plugin"
  },
  "files": [
    "dist",
    "src",
    "nextest.toml",
    "runtime-input.sh",
    "test-timings.json",
    "README.md",
    "loader.js",
    "generators.json",
    "executors.json",
    "!**/*.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__tests__",
    "managed",
    "runtime/nx-publish"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
