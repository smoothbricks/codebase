    "directory": "packages/nx-plugin"
  },
  "dependencies": {
    "@nx/js": "23.2.1",
    "@smoothbricks/build-inputs": "workspace:*",
    "@smoothbricks/cargo-retain": "workspace:*",
    "@smoothbricks/cowshed": "workspace:*",
    "@smoothbricks/nextest-extract": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "minimatch": "10.2.5",
    "nx": "latest",
    "prettier": "^3.9.8",
    "smol-toml": "^1.6.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typia": "15.2.1",
