{
  "name": "@smoothbricks/statebus-core",
  "version": "0.1.7",
  "author": "SmoothBricks Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/statebus-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bugs": "https://github.com/smoothbricks/statebus/issues",
  "description": "Platform-agnostic core types and runtime for StateBus.",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "CONSUMER.md"
  ],
  "homepage": "https://smoothbricks.dev/statebus",
  "keywords": [
    "data flow",
    "event bus",
    "eventbus",
    "observable",
    "reducer",
    "store",
    "state manager",
    "state management",
    "predictable",
    "functional"
  ],
  "license": "MIT",
  "dependencies": {
    "@tldraw/state": "^3.15.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "nx run statebus-core:test --outputStyle=stream"
  },
  "nx": {
    "namedInputs": {
      "verifyPackages": [
        "default",
        "bunToolchain",
        "{workspaceRoot}/bun.lock",
        "{projectRoot}/**/*.md",
        "{workspaceRoot}/bunfig.toml",
        {
          "json": "{workspaceRoot}/package.json",
          "excludeFields": [
            "version",
            "scripts",
            "smoo",
            "nx"
          ]
        },
        "{workspaceRoot}/packages/cli/src/monorepo/published-exports.ts",
        "{workspaceRoot}/packages/statebus-core/scripts/consumer/**/*",
        "{workspaceRoot}/packages/statebus-react/**/*",
        "{workspaceRoot}/packages/statebus-data-loader/**/*",
        "{workspaceRoot}/packages/statebus-tanstack-query/**/*",
        "{workspaceRoot}/packages/statebus-navigation-core/**/*",
        "{workspaceRoot}/packages/statebus-navigation-browser/**/*",
        "{workspaceRoot}/packages/lmao/**/*",
        "{workspaceRoot}/packages/arrow-builder/**/*",
        "{workspaceRoot}/packages/validation/**/*",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        {
          "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node --version"
        },
        {
          "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh uname -sm"
        },
        {
          "env": "GITHUB_SHA"
        },
        {
          "env": "STATEBUS_BENCH_COMMIT"
        }
      ]
    },
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}/src",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        },
        "dependsOn": [
          "...",
          "verify-packages"
        ]
      },
      "bench": {
        "executor": "nx:run-commands",
        "cache": true,
        "//": "Cached on the code it measures, the build it runs and the runtimes: a rerun with unchanged inputs measures nothing new.",
        "dependsOn": [
          "tsc-js"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/packages/nx-plugin/runtime-input.sh",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun --revision"
          },
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node --version"
          },
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          },
          {
            "env": "STATEBUS_BENCH_ORDER"
          },
          {
            "env": "STATEBUS_BENCH_COMMIT"
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun benchmarks/interest.mjs",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "v8": {
            "command": "node --expose-gc benchmarks/interest.mjs"
          }
        }
      },
      "bench-exact-interest": {
        "executor": "nx:run-commands",
        "cache": true,
        "//": "Cached on the code it measures, the build it runs and the runtimes: a rerun with unchanged inputs measures nothing new.",
        "dependsOn": [
          "tsc-js"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/packages/nx-plugin/runtime-input.sh",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun --revision"
          },
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node --version"
          },
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          },
          {
            "env": "STATEBUS_BENCH_ORDER"
          },
          {
            "env": "STATEBUS_BENCH_COMMIT"
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun benchmarks/exact-interest.mjs",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "v8": {
            "command": "node --expose-gc benchmarks/exact-interest.mjs"
          }
        }
      },
      "verify-packages": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "statebus-core",
              "statebus-react",
              "statebus-data-loader",
              "statebus-tanstack-query",
              "statebus-navigation-core",
              "statebus-navigation-browser",
              "lmao",
              "arrow-builder",
              "validation"
            ]
          }
        ],
        "options": {
          "command": "bun scripts/verify-packages.mjs",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "verifyPackages",
          "^dependencyDefault"
        ],
        "outputs": [
          "{workspaceRoot}/.cache/statebus-packages/"
        ]
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "statebus-core"
  },
  "publishConfig": {
    "access": "public"
  }
}
