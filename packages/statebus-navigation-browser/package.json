{
  "name": "@smoothbricks/statebus-navigation-browser",
  "version": "0.1.1",
  "type": "module",
  "description": "Explicitly owned browser history and URL-observation adapter for StateBus navigation.",
  "license": "MIT",
  "author": "SmoothBricks Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/statebus-navigation-browser"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@smoothbricks/statebus-navigation-core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@smoothbricks/statebus-core": "workspace:*",
    "@smoothbricks/statebus-react": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fast-check": "^4.4.0",
    "playwright": "^1.62.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "scripts": {
    "test": "nx run statebus-navigation-browser:test --outputStyle=stream"
  },
  "nx": {
    "name": "statebus-navigation-browser",
    "tags": [
      "npm:public"
    ],
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "test-browser": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "build",
          {
            "target": "build",
            "projects": [
              "cli"
            ]
          }
        ],
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "env": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"
          }
        ],
        "parallelism": false,
        "options": {
          "command": "smoo playwright run bun test --timeout=30000 browser",
          "cwd": "{projectRoot}",
          "timeoutMs": 180000,
          "killAfterMs": 10000
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
