{
  "name": "@smoothbricks/statebus-navigation-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Platform-neutral navigation intent, observation and reducer contracts for StateBus.",
  "license": "MIT",
  "author": "SmoothBricks Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/statebus-navigation-core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "@smoothbricks/statebus-core": "workspace:*"
  },
  "nx": {
    "name": "statebus-navigation-core",
    "tags": [
      "npm:public"
    ],
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
