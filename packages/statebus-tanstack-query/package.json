{
  "name": "@smoothbricks/statebus-tanstack-query",
  "version": "0.1.0",
  "type": "module",
  "description": "Interest-driven QueryClient execution and graceful cancellation for StateBus.",
  "license": "MIT",
  "author": "SmoothBricks Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothbricks/codebase.git",
    "directory": "packages/statebus-tanstack-query"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@smoothbricks/statebus-core": "workspace:*",
    "@smoothbricks/statebus-data-loader": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "@tanstack/query-core": "^5.101.4"
  },
  "nx": {
    "name": "statebus-tanstack-query",
    "tags": [
      "npm:public"
    ],
    "targets": {
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}/src",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.101.4"
  }
}
