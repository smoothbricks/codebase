+// listHostOutputs hands the files linked plugins reported writing beside a
+// whole-program emit's outputs to writeFile and lists them among the result's
+// EmittedFiles, unless the emit wrote nothing (noEmit, or noEmitOnError
+// withholding a failed program).
+func (p *Program) listHostOutputs(result *shimcompiler.EmitResult, writeFile shimcompiler.WriteFile) error {
+  if result == nil || result.EmitSkipped || p.TSProgram.Options().NoEmit.IsTrue() {
+    return nil
+  }
+  handed, err := p.writeHostOutputs(writeFile)
+  result.EmittedFiles = append(result.EmittedFiles, handed...)
+  return err
+}
+
+// writeHostOutputs hands each file a linked plugin reported writing beside the
+// compiler's outputs (PluginContext.ReportHostOutput) to writeFile, with its
+// bytes as they are now, after the compiler's own outputs, so a host lists it
+// with them. It answers the files handed, and fails on one it cannot read: a
+// plugin reported an output it did not leave.
+func (p *Program) writeHostOutputs(writeFile shimcompiler.WriteFile) ([]string, error) {
+  var handed []string
+  for _, file := range p.plugins.outputs.list() {
+    text, err := os.ReadFile(file)
+    if err != nil {
+      return handed, fmt.Errorf("ttsc driver: a linked plugin reported the host output %s, which cannot be read: %w", file, err)
+    }
+    if writeFile != nil {
+      err = writeFile(shimtspath.RootedFilePathFromAbsolute(file), string(text), nil)
+    } else {
+      err = DefaultWriteFile(file, string(text))
+    }
+    if err != nil {
+      return handed, err
+    }
+    handed = append(handed, file)
+  }
+  return handed, nil
+}
