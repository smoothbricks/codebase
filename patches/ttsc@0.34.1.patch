+
+// pluginHostOutputs keeps the files linked plugins reported writing beside the
+// compiler's outputs in this generation (ReportHostOutput), each once, in the
+// order first reported.
+type pluginHostOutputs struct {
+  mu    sync.Mutex
+  seen  map[string]struct{}
+  files []string
+}
+
+func newPluginHostOutputs() *pluginHostOutputs {
+  return &pluginHostOutputs{seen: map[string]struct{}{}}
+}
+
+func (outputs *pluginHostOutputs) add(file string) {
+  if outputs == nil {
+    return
+  }
+  outputs.mu.Lock()
+  defer outputs.mu.Unlock()
+  if _, ok := outputs.seen[file]; ok {
+    return
+  }
+  outputs.seen[file] = struct{}{}
+  outputs.files = append(outputs.files, file)
+}
+
+func (outputs *pluginHostOutputs) list() []string {
+  if outputs == nil {
+    return nil
   }
+  outputs.mu.Lock()
+  defer outputs.mu.Unlock()
+  return append([]string(nil), outputs.files...)
 }
 
