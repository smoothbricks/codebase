+func featureProgrammer_splitUninitializedLets(statements []*shimast.Node) (slots []*shimast.Node, rest []*shimast.Node) {
+  for _, statement := range statements {
+    if featureProgrammer_isUninitializedLet(statement) {
+      slots = append(slots, statement)
+    } else {
+      rest = append(rest, statement)
+    }
+  }
+  return slots, rest
+}
+
+func featureProgrammer_isUninitializedLet(statement *shimast.Node) bool {
+  if statement == nil || statement.Kind != shimast.KindVariableStatement {
+    return false
+  }
+  list := statement.AsVariableStatement().DeclarationList
+  if list == nil || list.Flags&shimast.NodeFlagsLet == 0 {
+    return false
+  }
+  for _, declaration := range list.AsVariableDeclarationList().Declarations.Nodes {
+    if declaration.AsVariableDeclaration().Initializer != nil {
+      return false
+    }
+  }
+  return true
+}
