 use futures::TryStreamExt;
 
+/// The first miss for a cache key compiles; later misses wait for it.
+pub(crate) enum InflightJoin {
+    Owner(InflightOwner),
+    Waiter,
+}
+
+/// Drops the in-flight slot and wakes waiters, even if the compile failed.
+pub(crate) struct InflightOwner {
+    map: Arc<StdMutex<HashMap<String, watch::Receiver<bool>>>>,
+    key: String,
+    tx: watch::Sender<bool>,
+}
+
+impl Drop for InflightOwner {
+    fn drop(&mut self) {
+        self.map
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .remove(&self.key);
+        let _ = self.tx.send(true);
+    }
+}
