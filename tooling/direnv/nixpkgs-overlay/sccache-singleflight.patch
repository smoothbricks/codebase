+                let (tx, rx) = watch::channel(false);
+                map.insert(key.to_owned(), rx);
+                return InflightJoin::Owner(InflightOwner {
+                    map: Arc::clone(&self.inflight),
+                    key: key.to_owned(),
+                    tx,
+                });
+            }
+        };
+        if let Some(mut rx) = waiting {
+            while !*rx.borrow() {
