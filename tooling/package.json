{
  "name": "@smoothbricks/tooling",
  "private": true,
  "nx": {
    "name": "tooling",
    "targets": {
      "nx-daemon-idle-proof-compile": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/packages/nx-plugin/src/testing.ts",
          "{workspaceRoot}/packages/nx-plugin/src/ensure-built.ts",
          "{workspaceRoot}/packages/nx-plugin/src/managed-assets.ts",
          {
            "externalDependencies": [
              "ttsc",
              "typescript",
              "typia",
              "nx"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "outputs": [
          "{workspaceRoot}/.cache/nx-daemon-idle-proof/"
        ],
        "options": {
          "command": "ttsc -p tooling/tsconfig.nx-daemon-idle-proof.json --emit",
          "cwd": "{workspaceRoot}"
        }
      },
      "nx-daemon-idle-proof": {
        "executor": "nx:run-commands",
        "cache": true,
        "//": "Cached on the compiled proof, the patched Nx it drives and the Bun that runs it.",
        "dependsOn": [
          "nx-daemon-idle-proof-compile"
        ],
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md",
          "{workspaceRoot}/packages/nx-plugin/runtime-input.sh",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh bun --revision"
          },
          {
            "externalDependencies": [
              "nx"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun --config=/dev/null --no-env-file --no-install .cache/nx-daemon-idle-proof/tooling/nx-daemon-idle-proof.js",
          "cwd": "{workspaceRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "...",
          {
            "projects": [
              "nx-plugin"
            ],
            "target": "tsc-js"
          },
          {
            "projects": [
              "nx-plugin"
            ],
            "target": "copy-nx-publish-assets"
          }
        ],
        "inputs": [
          "...",
          "default",
          "^dependencyDefault",
          "bunToolchain",
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh node --version"
          },
          {
            "dependentTasksOutputFiles": "**/dist/bin/smoo-nx-publish.js",
            "transitive": true
          },
          {
            "dependentTasksOutputFiles": "**/dist/nx-publish.js",
            "transitive": true
          },
          {
            "dependentTasksOutputFiles": "**/runtime/nx-publish/*.js",
            "transitive": true
          }
        ],
        "options": {
          "command": "bun test --timeout=0 direnv land-attribution.test land-decide.test land-host.test land-install.test && python3 -B -m unittest test_nx_patch.py",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "lint-dot-inputs": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/.nxignore",
          "{workspaceRoot}/**/.gitignore",
          {
            "externalDependencies": [
              "nx"
            ]
          },
          {
            "runtime": "sh node_modules/@smoothbricks/nx-plugin/runtime-input.sh env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c core.excludesFile=/dev/null ls-files -z"
          },
          "{workspaceRoot}/patches/**/*",
          "!{workspaceRoot}/patches/**/*.md"
        ],
        "outputs": [],
        "options": {
          "command": "bun tooling/lint-dot-inputs.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint-disk-commands": {
        "executor": "nx:run-commands",
        "cache": true,
        "//": "Cached on the files it scans: every file git lists that is not ignored, the same set the {workspaceRoot} fileset hashes, the policy script among them.",
        "inputs": [
          "{workspaceRoot}/**/*",
          {
            "externalDependencies": []
          }
        ],
        "outputs": [],
        "options": {
          "command": "bun packages/nx-plugin/src/disk-command-policy.ts .",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint": {
        "dependsOn": [
          "...",
          "lint-dot-inputs",
          "lint-disk-commands"
        ]
      }
    }
  },
  "dependencies": {
    "@smoothbricks/cli": "workspace:*",
    "@smoothbricks/failure-summary": "workspace:*",
    "@smoothbricks/nx-plugin": "workspace:*",
    "@smoothbricks/validation": "workspace:*",
    "typia": "15.2.1"
  }
}
