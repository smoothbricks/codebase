{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "direnv/**/*.test.ts",
    "direnv/**/*.spec.ts",
    "direnv/**/__tests__/**/*.ts",
    "direnv/**/__tests__/**/*.tsx",
    "*.test.ts",
    "*.spec.ts"
  ],
  "references": [
    {
      "path": "../packages/cli/tsconfig.lib.json"
    }
  ]
}
