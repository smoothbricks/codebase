{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules", "npm-prune-versions.ts"],
  "references": [
    {
      "path": "../packages/cli/tsconfig.lib.json"
    },
    { "path": "../packages/failure-summary/tsconfig.lib.json" }
  ]
}
